@model List<PropLink.Web.Models.BuyerInspectionItemViewModel>
@{
    ViewData["Title"] = "My Purchase & Inspection Requests - PropLink";
    var pendingCount = Model.Count(m => m.Status == PropLink.Domain.Enums.InspectionStatus.PendingSellerApproval);
    var acceptedCount = Model.Count(m => m.Status == PropLink.Domain.Enums.InspectionStatus.PendingAgentSchedule || m.Status == PropLink.Domain.Enums.InspectionStatus.ScheduleFixed);
    var completedCount = Model.Count(m => m.Status == PropLink.Domain.Enums.InspectionStatus.InspectionCompleted || m.Status == PropLink.Domain.Enums.InspectionStatus.UnderProcessing);
}

<div class="container py-5">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Property" asp-action="Index" class="text-decoration-none text-muted">Properties</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">My Requests</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-1 text-heading">
                <i class="bi bi-bag-check-fill text-primary me-2"></i>My Purchase & Inspection Requests
            </h1>
            <p class="text-muted small mb-0">
                Track status of your applied offers, inspection bookings, and assigned Verification Agent schedules.
            </p>
        </div>

        <a asp-controller="Property" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-search me-1"></i> Browse Marketplace
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ToastMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4 border-0 bg-success-subtle border-start border-4 border-success" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="text-dark fw-medium">@TempData["ToastMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4 border-0 bg-warning-subtle border-start border-4 border-warning" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                <div class="text-dark fw-medium">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Awaiting Seller Review</span>
                        <h3 class="fw-bold mb-0 text-dark">@pendingCount</h3>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Accepted / Agent Scheduled</span>
                        <h3 class="fw-bold mb-0 text-dark">@acceptedCount</h3>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-person-badge fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Completed & In Processing</span>
                        <h3 class="fw-bold mb-0 text-dark">@completedCount</h3>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-patch-check-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Requests Queue Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-check me-2 text-primary"></i>Your Applied Requests (@Model.Count)
            </h5>
            <span class="badge bg-light text-muted border px-3 py-2 rounded-pill small">
                Updated in Real-Time
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 px-3">
                <div class="p-4 bg-light rounded-circle d-inline-block mb-3 text-muted">
                    <i class="bi bi-journal-x fs-1"></i>
                </div>
                <h5 class="fw-bold text-dark">No Inspection or Purchase Requests Yet</h5>
                <p class="text-muted small max-w-md mx-auto mb-4">
                    Explore verified properties in our registry and submit a direct purchase or price offer request to schedule an on-site deed inspection.
                </p>
                <a asp-controller="Property" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-house-door me-1"></i> Browse Verified Properties
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-4 py-3">Property</th>
                            <th class="py-3">Your Request / Offer</th>
                            <th class="py-3">Preferred Date</th>
                            <th class="py-3">Current Status</th>
                            <th class="py-3">Assigned Agent & Meeting</th>
                            <th class="pe-4 py-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- Property Info -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@item.PropertyImageUrl" alt="@item.PropertyTitle"
                                             class="rounded-3 object-fit-cover shadow-sm"
                                             style="width: 72px; height: 54px;" />
                                        <div>
                                            <a asp-controller="Property" asp-action="Details" asp-route-id="@item.PropertyId"
                                               class="fw-bold text-dark text-decoration-none hover-primary d-block">
                                                @item.PropertyTitle
                                            </a>
                                            <span class="small text-muted d-block">
                                                <i class="bi bi-geo-alt me-1"></i>@item.PropertyCity
                                            </span>
                                            <span class="badge bg-light text-dark border small mt-1">
                                                Seller: @item.SellerName
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Offer / Price Info -->
                                <td class="py-3">
                                    @if (item.InspectionType == "PriceOfferWithInspection" && item.OfferedPrice.HasValue)
                                    {
                                        <div>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small mb-1">
                                                <i class="bi bi-tag-fill me-1"></i>Custom Offer
                                            </span>
                                            <div class="fw-bold text-success fs-6">
                                                $@item.OfferedPrice.Value.ToString("N0")
                                            </div>
                                            <div class="small text-muted text-decoration-line-through">
                                                Asking: $@item.AskingPrice.ToString("N0")
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small mb-1">
                                                <i class="bi bi-check-circle-fill me-1"></i>Asking Price
                                            </span>
                                            <div class="fw-bold text-dark fs-6">
                                                $@item.AskingPrice.ToString("N0")
                                            </div>
                                        </div>
                                    }
                                </td>

                                <!-- Preferred Date -->
                                <td class="py-3">
                                    <div class="fw-semibold text-dark small">
                                        <i class="bi bi-calendar3 me-1 text-primary"></i>@item.PreferredDate.ToString("MMM dd, yyyy")
                                    </div>
                                    <div class="text-muted small">
                                        Applied: @item.CreatedAt.ToString("MMM dd, yyyy")
                                    </div>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3">
                                    @switch (item.Status)
                                    {
                                        case PropLink.Domain.Enums.InspectionStatus.PendingSellerApproval:
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-hourglass-split me-1"></i> Pending Seller Review
                                            </span>
                                            <div class="small text-muted mt-1">Awaiting seller selection</div>
                                            break;

                                        case PropLink.Domain.Enums.InspectionStatus.PendingAgentSchedule:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-check-lg me-1"></i> Accepted by Seller!
                                            </span>
                                            <div class="small text-primary fw-medium mt-1">Forwarded to Verification Agent</div>
                                            break;

                                        case PropLink.Domain.Enums.InspectionStatus.ScheduleFixed:
                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-calendar-check-fill me-1"></i> Schedule Confirmed
                                            </span>
                                            <div class="small text-dark fw-bold mt-1">@item.ScheduledDate?.ToString("g")</div>
                                            break;

                                        case PropLink.Domain.Enums.InspectionStatus.InspectionCompleted:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-patch-check-fill me-1"></i> Inspection Completed
                                            </span>
                                            break;

                                        case PropLink.Domain.Enums.InspectionStatus.UnderProcessing:
                                            <span class="badge bg-dark text-white rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-lock-fill me-1"></i> Under Processing
                                            </span>
                                            <div class="small text-muted mt-1">Title Transfer in Progress</div>
                                            break;

                                        case PropLink.Domain.Enums.InspectionStatus.DeclinedBySeller:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-x-circle me-1"></i> Declined by Seller
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">
                                                @item.Status.ToString()
                                            </span>
                                            break;
                                    }
                                </td>

                                <!-- Assigned Agent & Meeting Info -->
                                <td class="py-3">
                                    @if (item.Status == PropLink.Domain.Enums.InspectionStatus.ScheduleFixed || item.Status == PropLink.Domain.Enums.InspectionStatus.InspectionCompleted || item.Status == PropLink.Domain.Enums.InspectionStatus.UnderProcessing)
                                    {
                                        <div class="small fw-semibold text-dark">
                                            <i class="bi bi-person-badge text-primary me-1"></i>@(item.AgentName ?? "Verification Agent")
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.MeetingLocationNotes))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 200px;" title="@item.MeetingLocationNotes">
                                                <i class="bi bi-geo me-1"></i>@item.MeetingLocationNotes
                                            </div>
                                        }
                                    }
                                    else if (item.Status == PropLink.Domain.Enums.InspectionStatus.PendingAgentSchedule)
                                    {
                                        <div class="small text-muted">
                                            <i class="bi bi-clock-history me-1"></i>Agent will set meeting time soon
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">
                                            <i class="bi bi-shield-lock me-1"></i>Agent assigned upon seller acceptance
                                        </div>
                                    }
                                </td>

                                <!-- Action -->
                                <td class="pe-4 py-3 text-end">
                                    <a asp-controller="Property" asp-action="Details" asp-route-id="@item.PropertyId"
                                       class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> View Property
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Offcanvas Sliding Door Navigation Menu (Triggered by Hamburger ☰) *@

<div class="offcanvas offcanvas-start proplink-offcanvas-menu" tabindex="-1" id="proplinkSidebarMenu" aria-labelledby="proplinkSidebarMenuLabel">
    <div class="offcanvas-header border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
        <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
            <div class="brand-logo-icon" style="width: 32px; height: 32px; font-size: 1rem;">
                <i class="bi bi-shield-check"></i>
            </div>
            <span class="brand-name fs-5">Prop<span>Link</span></span>
            <span class="badge badge-trust ms-1"><i class="bi bi-patch-check-fill text-emerald me-1"></i>Verified</span>
        </a>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body p-4 d-flex flex-column justify-content-between">
        <div>
            <!-- MAIN NAVIGATION -->
            <div class="mb-4">
                <div class="text-uppercase small text-muted fw-bold mb-2" style="font-size: 0.72rem; letter-spacing: 0.06em;">
                    <i class="bi bi-compass me-1 text-emerald"></i> Main Navigation
                </div>
                <div class="nav flex-column sidebar-nav-list gap-1">
                    <a asp-controller="Home" asp-action="Index" class="sidebar-nav-item">
                        <i class="bi bi-house-door-fill text-emerald"></i>
                        <span>Home</span>
                        <span class="badge bg-emerald-light text-emerald ms-auto">Explore</span>
                    </a>
                    <a asp-controller="Property" asp-action="Index" class="sidebar-nav-item">
                        <i class="bi bi-patch-check-fill text-emerald"></i>
                        <span>Verified Properties</span>
                        <span class="badge bg-success-subtle text-success ms-auto">Catalog</span>
                    </a>
                    <a asp-controller="Property" asp-action="Sell" class="sidebar-nav-item">
                        <i class="bi bi-plus-circle-fill text-emerald"></i>
                        <span>Sell Property</span>
                        <span class="badge bg-primary-subtle text-primary ms-auto">+ List</span>
                    </a>
                    <a href="@Url.Action("Index", "Home")#how-it-works" class="sidebar-nav-item" data-bs-dismiss="offcanvas">
                        <i class="bi bi-diagram-3-fill text-muted"></i>
                        <span>How It Works</span>
                    </a>
                    <a href="@Url.Action("Index", "Home")#trust-guarantee" class="sidebar-nav-item" data-bs-dismiss="offcanvas">
                        <i class="bi bi-shield-check text-muted"></i>
                        <span>Trust Guarantee</span>
                    </a>
                    <a asp-controller="Property" asp-action="Compare" class="sidebar-nav-item">
                        <i class="bi bi-columns-gap text-emerald"></i>
                        <span>Property Comparator</span>
                        <span class="badge bg-info-subtle text-info ms-auto">Compare</span>
                    </a>
                </div>
            </div>

            <hr class="my-3 border-opacity-25" />

            <!-- ACCOUNT & USER ACTIONS -->
            <div class="mb-4">
                <div class="text-uppercase small text-muted fw-bold mb-2" style="font-size: 0.72rem; letter-spacing: 0.06em;">
                    <i class="bi bi-person-badge-fill me-1 text-emerald"></i> Account & Portfolio
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="sidebar-user-card p-3 rounded-4 mb-3 d-flex align-items-center gap-3">
                        <div class="seller-avatar" style="width: 40px; height: 40px; font-size: 0.95rem; background: var(--emerald-gradient); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                            @(string.IsNullOrEmpty(User.Identity.Name) ? "U" : User.Identity.Name.Substring(0, 1))
                        </div>
                        <div class="overflow-hidden flex-grow-1">
                            <div class="fw-bold text-heading text-truncate">@User.Identity.Name</div>
                            <div class="small text-muted text-truncate">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                            <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : "bg-emerald-light text-emerald") mt-1" style="font-size: 0.7rem;">
                                @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Verified Member")
                            </span>
                        </div>
                    </div>

                    <div class="nav flex-column sidebar-nav-list gap-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Verifications" class="sidebar-nav-item text-danger fw-bold">
                                <i class="bi bi-shield-lock-fill text-danger"></i>
                                <span>Admin Verifications Queue</span>
                            </a>
                        }
                        <a asp-controller="Profile" asp-action="Index" class="sidebar-nav-item">
                            <i class="bi bi-person-circle text-emerald"></i>
                            <span>My Profile & Dashboard</span>
                        </a>
                        <a asp-controller="Profile" asp-action="Index" class="sidebar-nav-item">
                            <i class="bi bi-building text-emerald"></i>
                            <span>My Listed Properties</span>
                        </a>
                        <a asp-controller="Profile" asp-action="Index" class="sidebar-nav-item">
                            <i class="bi bi-bag-check text-emerald"></i>
                            <span>Purchase Agreements</span>
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                                <i class="bi bi-box-arrow-right"></i> Sign Out
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="p-3 rounded-4 bg-light border text-center mb-3">
                        <i class="bi bi-person-circle fs-2 text-muted mb-2 d-block"></i>
                        <h6 class="fw-bold mb-1">Welcome to PropLink</h6>
                        <p class="small text-muted mb-3">Sign in to manage verified listings or track purchase agreements.</p>
                        <div class="d-grid gap-2">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom btn-sm py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>Sign In</span>
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-custom btn-sm py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-person-plus"></i>
                                <span>Create Account</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- FOOTER TRUST GUARANTEE -->
        <div class="pt-3 border-top mt-auto">
            <div class="sidebar-trust-box p-3 rounded-3 text-center">
                <i class="bi bi-shield-fill-check text-emerald fs-4 d-block mb-1"></i>
                <div class="small fw-bold text-heading">100% Deed Verified Platform</div>
                <div class="text-muted" style="font-size: 0.72rem;">Administrative deed review and tax clearance audited before publication.</div>
            </div>
        </div>
    </div>
</div>

<nav class="navbar navbar-expand-lg proplink-navbar sticky-top">
    <div class="container">
        <div class="d-flex align-items-center gap-2">
            <!-- Hamburger Sliding Menu Button ☰ -->
            <button class="btn btn-hamburger-nav d-flex align-items-center justify-content-center me-1" 
                    type="button" 
                    data-bs-toggle="offcanvas" 
                    data-bs-target="#proplinkSidebarMenu" 
                    aria-controls="proplinkSidebarMenu" 
                    title="Open Navigation Menu" 
                    aria-label="Toggle Navigation Menu">
                <i class="bi bi-list fs-4"></i>
            </button>

            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <div class="brand-logo-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <span class="brand-name">Prop<span>Link</span></span>
                <span class="badge badge-trust ms-1 d-none d-sm-inline-flex">
                    <i class="bi bi-patch-check-fill text-emerald me-1"></i>Verified
                </span>
            </a>
        </div>

        <!-- Dark Mode Toggle Button (Mobile) -->
        <div class="d-flex align-items-center gap-2 d-lg-none ms-auto me-2">
            <button class="btn-theme-toggle" id="themeToggleBtnMobile" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
                <i class="bi bi-moon-stars-fill theme-icon-moon"></i>
                <i class="bi bi-sun-fill theme-icon-sun text-warning d-none"></i>
            </button>
        </div>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Property" asp-action="Index">
                        <i class="bi bi-patch-check-fill text-emerald me-1"></i>Verified Properties
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Property" asp-action="Sell">
                        <i class="bi bi-plus-circle text-emerald me-1"></i>Sell Property
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")#how-it-works">How It Works</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")#trust-guarantee">Trust Guarantee</a>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-2">
                <!-- Theme Mode Toggle (Desktop) -->
                <button class="btn-theme-toggle d-none d-lg-flex" id="themeToggleBtn" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
                    <i class="bi bi-moon-stars-fill theme-icon-moon"></i>
                    <i class="bi bi-sun-fill theme-icon-sun text-warning d-none"></i>
                </button>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-custom dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="seller-avatar" style="width: 28px; height: 28px; font-size: 0.75rem; background: var(--emerald-gradient); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                                @(string.IsNullOrEmpty(User.Identity.Name) ? "U" : User.Identity.Name.Substring(0, 1))
                            </div>
                            <span class="fw-bold">@User.Identity.Name</span>
                            <span class="badge bg-emerald-light text-emerald border border-emerald-subtle">
                                @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                            <li><h6 class="dropdown-header">Signed in as <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</strong></h6></li>
                            <li><hr class="dropdown-divider"></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 fw-bold text-danger" asp-controller="Admin" asp-action="Verifications">
                                        <i class="bi bi-shield-lock-fill text-danger"></i> Admin Verifications Queue
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle text-emerald"></i> My Profile & Activity</a></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Property" asp-action="Sell"><i class="bi bi-plus-circle text-emerald"></i> Sell a Property</a></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index"><i class="bi bi-building text-emerald"></i> Selling / Listing History</a></li>
                            <li><a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index"><i class="bi bi-bag-check text-muted"></i> Buying History</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-custom d-flex align-items-center gap-2">
                        <i class="bi bi-person-plus"></i>
                        <span>Register</span>
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom d-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Sign In</span>
                    </a>
                }
            </div>
        </div>
    </div>
</nav>

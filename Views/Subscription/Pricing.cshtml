@model PropLink.Web.Models.SubscriptionPricingViewModel
@{
    ViewData["Title"] = "Membership & Subscription - PropLink";
    var limitReachedMsg = TempData["SubscriptionLimitReached"] as string;
}

<div class="container py-5 subscription-page">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-5">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold mb-2">
            <i class="bi bi-gem me-1"></i> Membership Plans
        </span>
        <h2 class="display-6 fw-bold sub-heading-text mb-3">Upgrade Your PropLink Experience</h2>
        <p class="sub-muted-text lead fs-6 max-w-md mx-auto">
            Choose the plan that fits your real estate goals. Post more verified properties and schedule unlimited on-site physical deed inspections.
        </p>
    </div>

    <!-- Limit Alert (If redirected from hitting limit) -->
    @if (!string.IsNullOrEmpty(limitReachedMsg))
    {
        <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-5 p-4 d-flex align-items-center gap-3 sub-alert-warning">
            <div class="p-3 bg-warning text-dark rounded-circle flex-shrink-0">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1 sub-heading-text">Monthly Limit Reached</h5>
                <p class="mb-0 sub-muted-text">@limitReachedMsg</p>
            </div>
        </div>
    }

    <!-- Current Membership & Monthly Usage Card (For Logged In Users) -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="card sub-card border-0 shadow-sm rounded-4 mb-5 p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <span class="small sub-muted-text text-uppercase fw-bold" style="letter-spacing: 0.8px;">MEMBERSHIP STATUS</span>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                        @if (Model.IsSubscribed)
                        {
                            <div class="pro-vip-subscriber-badge">
                                <span class="pro-vip-icon"><i class="bi bi-patch-check-fill"></i></span>
                                <div class="pro-vip-text-wrap">
                                    <span class="pro-vip-title">PropLink Pro Member</span>
                                    <span class="pro-vip-sub">Verified Investor Tier</span>
                                </div>
                                <span class="pro-vip-chip">
                                    <span class="pulse-indicator"></span> ACTIVE
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="free-starter-badge">
                                <i class="bi bi-shield text-muted fs-5"></i>
                                <span class="fw-bold sub-heading-text">PropLink Free Starter</span>
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">Standard</span>
                            </div>
                        }
                    </div>
                </div>

                @if (Model.IsSubscribed)
                {
                    <div class="text-lg-end">
                        <div class="pro-validity-card px-3 py-2 rounded-3">
                            <span class="small sub-muted-text d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">ACTIVE VALIDITY</span>
                            <span class="fw-bold text-success">
                                <i class="bi bi-clock-history me-1"></i>@Model.DaysRemaining days remaining
                            </span>
                            <small class="sub-muted-text d-block" style="font-size: 0.74rem;">Renews @Model.SubscriptionExpiresAt?.ToString("MMM dd, yyyy")</small>
                        </div>
                    </div>
                }
            </div>

            <!-- Usage Progress Bars -->
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 sub-inner-box rounded-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold sub-heading-text small">
                                <i class="bi bi-house-add-fill text-primary me-1"></i> Properties Posted This Month
                            </span>
                            <span class="badge @(Model.CanPostMore ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-2 py-1">
                                @Model.PostsUsedThisMonth / @Model.PostLimit Used
                            </span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            @{
                                var postPercent = Math.Min(100, (int)((double)Model.PostsUsedThisMonth / Model.PostLimit * 100));
                            }
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @postPercent%;" aria-valuenow="@postPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="sub-muted-text mt-2 d-block" style="font-size: 0.76rem;">
                            @(Model.IsSubscribed ? "Pro members can post up to 10 verified properties each month." : "Free members can post 1 property per month. Upgrade to Pro for 10 posts.")
                        </small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 sub-inner-box rounded-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold sub-heading-text small">
                                <i class="bi bi-geo-alt-fill text-emerald me-1"></i> Property Visits / Inspections Requested
                            </span>
                            <span class="badge @(Model.IsSubscribed ? "bg-success-subtle text-success border border-success-subtle" : (Model.CanRequestMoreVisits ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")) rounded-pill px-2 py-1">
                                @(Model.IsSubscribed ? $"{Model.VisitsUsedThisMonth} (Unlimited)" : $"{Model.VisitsUsedThisMonth} / {Model.VisitLimit} Used")
                            </span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            @{
                                var visitPercent = Model.IsSubscribed ? 30 : Math.Min(100, (int)((double)Model.VisitsUsedThisMonth / Model.VisitLimit * 100));
                            }
                            <div class="progress-bar bg-success" role="progressbar" style="width: @visitPercent%;" aria-valuenow="@visitPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="sub-muted-text mt-2 d-block" style="font-size: 0.76rem;">
                            @(Model.IsSubscribed ? "⭐ You have unlimited property visit requests as a Pro subscriber." : "Free members can request 2 visits per month. Upgrade to Pro for unlimited visits.")
                        </small>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Gateway Mode Banner for Classroom Demo / Presentation -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 p-3 sub-card" style="border-left: 4px solid #d9385d !important;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 px-3 bg-danger text-white rounded-3 fs-4 fw-bold">
                    <i class="bi bi-phone-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold sub-heading-text mb-0">bKash & Nagad Simulator (With Phone & PIN Input)</h6>
                    <small class="sub-muted-text">Demonstrate entering custom mobile number, OTP, and secret PIN for classroom evaluation.</small>
                </div>
            </div>
            <a href="/subscription/sandbox-gateway" class="btn btn-danger rounded-pill px-4 py-2 fw-bold d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-arrow-right-circle-fill"></i>
                <span>Launch bKash / Nagad Simulator</span>
            </a>
        </div>
    </div>

    <!-- Pricing Comparison Cards -->
    <div class="row g-4 justify-content-center align-items-stretch">
        <!-- FREE TIER -->
        <div class="col-lg-5 col-md-6">
            <div class="card sub-card h-100 border-0 shadow-sm rounded-4 p-4 p-xl-5 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold sub-heading-text mb-0">Starter</h4>
                        <span class="badge bg-light text-muted border px-3 py-1 rounded-pill small">Standard</span>
                    </div>
                    <p class="sub-muted-text small mb-4">Essential access to verified real estate marketplace.</p>
                    <div class="mb-4">
                        <span class="display-5 fw-bold sub-heading-text">৳0</span>
                        <span class="sub-muted-text">/ month</span>
                    </div>

                    <ul class="list-unstyled d-flex flex-column gap-3 mb-4">
                        <li class="d-flex align-items-center gap-2 sub-heading-text small">
                            <i class="bi bi-check-circle-fill text-success fs-6"></i>
                            <span><strong>1 Property Post</strong> per month</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 sub-heading-text small">
                            <i class="bi bi-check-circle-fill text-success fs-6"></i>
                            <span><strong>2 Property Visits / Inspections</strong> per month</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 sub-heading-text small">
                            <i class="bi bi-check-circle-fill text-success fs-6"></i>
                            <span>Access to deed document audits</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 sub-heading-text small">
                            <i class="bi bi-check-circle-fill text-success fs-6"></i>
                            <span>Anti-bypass direct chat (once schedule fixed)</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 sub-muted-text small opacity-50">
                            <i class="bi bi-x-circle fs-6"></i>
                            <span class="text-decoration-line-through">Unlimited property visits</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 sub-muted-text small opacity-50">
                            <i class="bi bi-x-circle fs-6"></i>
                            <span class="text-decoration-line-through">Priority agent verification dispatch</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-4">
                    <button class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-semibold" disabled>
                        @(Model.IsSubscribed ? "Free Plan" : "Current Plan")
                    </button>
                </div>
            </div>
        </div>

        <!-- PRO TIER -->
        <div class="col-lg-5 col-md-6">
            <div class="card sub-card pro-card h-100 border-0 shadow-lg rounded-4 p-4 p-xl-5 d-flex flex-column justify-content-between position-relative overflow-hidden">
                <!-- Eye-Catching Modern Pro Floating Tag -->
                <div class="pro-luxury-tag">
                    <i class="bi bi-stars me-1"></i> MOST POPULAR
                </div>

                <div>
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 mt-1 gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="pro-crown-badge">
                                <i class="bi bi-patch-check-fill"></i>
                            </div>
                            <h4 class="fw-bold text-white mb-0">PropLink Pro</h4>
                        </div>
                        <span class="pro-power-pill">
                            <span class="pulse-indicator"></span>
                            <span>10X CAPACITY</span>
                        </span>
                    </div>
                    <p class="text-white-50 small mb-4">Complete freedom for serious buyers, sellers, and investors.</p>
                    <div class="mb-4">
                        <span class="display-5 fw-bold text-white">৳@Model.MonthlyProPrice.ToString("F0")</span>
                        <span class="text-white-50">/ month</span>
                    </div>

                    <ul class="list-unstyled d-flex flex-column gap-3 mb-4">
                        <li class="d-flex align-items-center gap-2 text-white small">
                            <i class="bi bi-check-circle-fill text-warning fs-6"></i>
                            <span><strong>10 Property Posts</strong> per month (10x capacity!)</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 text-white small">
                            <i class="bi bi-check-circle-fill text-warning fs-6"></i>
                            <span><strong>Unlimited Property Visits / Inspections</strong></span>
                        </li>
                        <li class="d-flex align-items-center gap-2 text-white small">
                            <i class="bi bi-check-circle-fill text-warning fs-6"></i>
                            <span><strong>⭐ Verified Pro Member Badge</strong> on your profile & listings</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 text-white small">
                            <i class="bi bi-check-circle-fill text-warning fs-6"></i>
                            <span>Priority verification queue by Field Agents</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 text-white small">
                            <i class="bi bi-check-circle-fill text-warning fs-6"></i>
                            <span>Full Live Auction & Bidding capabilities</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 text-white small">
                            <i class="bi bi-check-circle-fill text-warning fs-6"></i>
                            <span>Secure Checkout via <strong>bKash, Nagad, Visa, Mastercard</strong></span>
                        </li>
                    </ul>
                </div>

                <div class="mt-4 d-flex flex-column gap-2">
                    @if (Model.IsSubscribed)
                    {
                        <div class="pro-active-banner p-3 rounded-4 text-center mb-2">
                            <div class="d-flex align-items-center justify-content-center gap-2 text-warning fw-bold mb-1">
                                <i class="bi bi-stars fs-5"></i>
                                <span class="fs-6">Active Pro Subscriber</span>
                            </div>
                            <small class="text-white-75 d-block" style="font-size: 0.78rem;">
                                Enjoy 10 property posts & unlimited physical deed inspections.
                            </small>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Subscription" asp-action="Initiate" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <span>Upgrade via SSLCommerz — ৳@Model.MonthlyProPrice.ToString("F0")/mo</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </form>
                    }

                    <!-- Direct bKash / Nagad Phone & PIN Simulator -->
                    <a href="/subscription/sandbox-gateway" class="btn btn-outline-light w-100 py-2 rounded-pill fw-semibold text-center small mt-1 shadow-sm">
                        <i class="bi bi-phone-fill text-danger me-1"></i> Pay with bKash / Nagad (Phone & PIN Simulator)
                    </a>

                    <!-- 1-Click Sandbox Test Helper for Classroom Defense -->
                    @if (!Model.IsSubscribed)
                    {
                        <form asp-controller="Subscription" asp-action="QuickActivate" method="post" class="mt-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link text-white-50 text-decoration-none w-100 py-1 opacity-75" title="Instant test activation for evaluation">
                                <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> 1-Click Quick Activate (Instant Pro)
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Supported Payment Partners -->
    <div class="text-center mt-5 pt-4">
        <span class="small sub-muted-text text-uppercase fw-semibold d-block mb-3" style="letter-spacing: 0.5px;">
            Secure Sandbox Payment Gateway Powered by SSLCommerz
        </span>
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 opacity-75">
            <span class="badge bg-light text-dark border px-3 py-2 rounded-3 fw-bold">
                <i class="bi bi-phone-fill text-danger me-1"></i> bKash
            </span>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-3 fw-bold">
                <i class="bi bi-wallet2 text-warning me-1"></i> Nagad
            </span>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-3 fw-bold">
                <i class="bi bi-credit-card-2-front-fill text-primary me-1"></i> Visa Card
            </span>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-3 fw-bold">
                <i class="bi bi-credit-card-fill text-danger me-1"></i> MasterCard
            </span>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-3 fw-bold">
                <i class="bi bi-bank text-secondary me-1"></i> Internet Banking
            </span>
        </div>
    </div>
</div>

<style>
    .subscription-page {
        color: var(--text-body);
    }
    .sub-heading-text {
        color: var(--text-heading) !important;
    }
    .sub-muted-text {
        color: var(--text-muted) !important;
    }
    .sub-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        transition: var(--transition-smooth);
    }
    .sub-inner-box {
        background: var(--bg-subtle);
        border: 1px solid var(--border-color);
    }
    .pro-card {
        background: linear-gradient(145deg, #044e39 0%, #065f46 45%, #022c22 100%) !important;
        border: 2px solid rgba(245, 158, 11, 0.45) !important;
        box-shadow: 0 16px 45px -8px rgba(4, 120, 87, 0.4), 0 0 20px rgba(245, 158, 11, 0.2) !important;
    }
    
    /* Modern Luxury Pro Floating Tag */
    .pro-luxury-tag {
        position: absolute;
        top: 20px;
        right: 20px;
        background: linear-gradient(135deg, #fef08a 0%, #f59e0b 50%, #d97706 100%);
        color: #1a1a1a;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.8px;
        padding: 6px 16px;
        border-radius: 9999px;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
        display: inline-flex;
        align-items: center;
        z-index: 5;
    }

    /* Pro Crown Badge */
    .pro-crown-badge {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(217, 119, 6, 0.35));
        border: 1px solid rgba(245, 158, 11, 0.5);
        color: #fbbf24;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        box-shadow: 0 0 12px rgba(245, 158, 11, 0.3);
    }

    /* Pro Power Pill */
    .pro-power-pill {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 9999px;
        padding: 4px 12px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.6px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        backdrop-filter: blur(4px);
    }

    /* Pulse Indicator */
    .pulse-indicator {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        display: inline-block;
        box-shadow: 0 0 8px #10b981;
        animation: statusPulse 1.8s infinite;
    }

    @@keyframes statusPulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* VIP Subscriber Badge on Top */
    .pro-vip-subscriber-badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.12) 0%, rgba(217, 119, 6, 0.22) 100%);
        border: 1.5px solid rgba(245, 158, 11, 0.5);
        border-radius: 9999px;
        padding: 8px 18px 8px 10px;
        box-shadow: 0 4px 20px rgba(245, 158, 11, 0.2);
    }

    .pro-vip-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fbbf24, #d97706);
        color: #1a1a1a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
    }

    .pro-vip-text-wrap {
        display: flex;
        flex-direction: column;
    }

    .pro-vip-title {
        font-weight: 800;
        font-size: 1.05rem;
        color: var(--text-heading);
        line-height: 1.2;
    }

    .pro-vip-sub {
        font-size: 0.72rem;
        color: #f59e0b;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .pro-vip-chip {
        background: #10b981;
        color: #fff;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        padding: 3px 10px;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-left: 6px;
    }

    /* Free Starter Badge */
    .free-starter-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--bg-subtle);
        border: 1px solid var(--border-color);
        padding: 8px 16px;
        border-radius: 9999px;
    }

    .pro-validity-card {
        background: var(--bg-subtle);
        border: 1px solid var(--border-color);
    }

    /* Pro Active Footer Banner */
    .pro-active-banner {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.2) 0%, rgba(4, 120, 87, 0.3) 100%);
        border: 1px solid rgba(245, 158, 11, 0.4);
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    .sub-alert-warning {
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.35);
    }
</style>

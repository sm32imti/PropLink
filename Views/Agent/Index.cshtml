@model List<PropLink.Web.Models.AgentInspectionItemViewModel>
@{
    ViewData["Title"] = "Verification Agent Portal - PropLink";
    var pendingCount = Model.Count(m => m.Status == PropLink.Domain.Enums.InspectionStatus.PendingAgentSchedule);
    var scheduledCount = Model.Count(m => m.Status == PropLink.Domain.Enums.InspectionStatus.ScheduleFixed);
    var underProcessingCount = Model.Count(m => m.Status == PropLink.Domain.Enums.InspectionStatus.UnderProcessing);
}

<div class="container py-5">
    <!-- Header & Breadcrumbs -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Verification Agent Workspace</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-1 text-heading">
                <i class="bi bi-person-badge-fill text-primary me-2"></i>Field Inspection & Schedule Workspace
            </h1>
            <p class="text-muted small mb-0">
                Official portal for PropLink Verification Agents to coordinate, fix on-site meeting times, and witness deed audits.
            </p>
        </div>

        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-bold">
            <i class="bi bi-shield-check me-1"></i> Authorized Verification Agent
        </span>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["ToastMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4 border-0 bg-success-subtle border-start border-4 border-success" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="text-dark fw-medium">@TempData["ToastMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4 border-0 bg-danger-subtle border-start border-4 border-danger" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="text-dark fw-medium">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Counter Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Needs Schedule Fixed</span>
                        <h3 class="fw-bold mb-0 text-dark">@pendingCount</h3>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-calendar-plus fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Confirmed & Upcoming</span>
                        <h3 class="fw-bold mb-0 text-dark">@scheduledCount</h3>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-calendar2-check-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Under Processing (Locked)</span>
                        <h3 class="fw-bold mb-0 text-dark">@underProcessingCount</h3>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-lock-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Inspection Queue Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="card-header bg-white border-bottom p-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-heading">Physical Inspection Task Queue</h5>
            <span class="small text-muted">Showing all platform inspection requests</span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Property</th>
                            <th>Inspection Type & Price</th>
                            <th>Buyer & Seller</th>
                            <th>Requested Date</th>
                            <th>Agent Schedule</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Agent Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@item.PropertyImageUrl" alt="@item.PropertyTitle" class="rounded-3 shadow-sm object-fit-cover" style="width: 54px; height: 54px;" />
                                        <div>
                                            <a asp-controller="Property" asp-action="Details" asp-route-id="@item.PropertyId" class="fw-bold text-dark text-decoration-none d-block text-truncate" style="max-width: 220px;" target="_blank">
                                                @item.PropertyTitle
                                            </a>
                                            <span class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@item.PropertyCity</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (item.InspectionType == "PriceOfferWithInspection" && item.OfferedPrice.HasValue)
                                    {
                                        <div>
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle mb-1">
                                                <i class="bi bi-tag-fill me-1"></i>Custom Offer
                                            </span>
                                            <div class="fw-bold text-success fs-6">$@item.OfferedPrice.Value.ToString("N0")</div>
                                            <div class="small text-muted">Asking: $@item.AskingPrice.ToString("N0")</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle mb-1">
                                                <i class="bi bi-check-circle-fill me-1"></i>Asking Price
                                            </span>
                                            <div class="fw-bold text-dark fs-6">$@item.AskingPrice.ToString("N0")</div>
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="small">
                                        <div class="fw-bold text-dark"><i class="bi bi-person me-1 text-primary"></i>Buyer: @item.BuyerName</div>
                                        <div class="text-muted"><i class="bi bi-house me-1 text-secondary"></i>Seller: @item.SellerName</div>
                                    </div>
                                </td>

                                <td>
                                    <div class="small">
                                        <span class="fw-semibold text-dark">@item.PreferredDate.ToString("MMM dd, yyyy")</span>
                                        <div class="text-muted" style="font-size: 0.75rem;">@item.BuyerNotes</div>
                                    </div>
                                </td>

                                <td>
                                    @if (item.ScheduledDate.HasValue)
                                    {
                                        <div class="small">
                                            <span class="badge bg-primary text-white mb-1">
                                                <i class="bi bi-calendar-check me-1"></i>@item.ScheduledDate.Value.ToString("MMM dd, yyyy")
                                            </span>
                                            <div class="fw-bold text-dark">@item.ScheduledDate.Value.ToString("hh:mm tt")</div>
                                            @if (!string.IsNullOrEmpty(item.MeetingLocationNotes))
                                            {
                                                <span class="text-muted small d-block text-truncate" style="max-width: 160px;" title="@item.MeetingLocationNotes">@item.MeetingLocationNotes</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-hourglass me-1"></i>Awaiting Agent Schedule
                                        </span>
                                    }
                                </td>

                                <td>
                                    @switch (item.Status)
                                    {
                                        case PropLink.Domain.Enums.InspectionStatus.PendingAgentSchedule:
                                            <span class="badge bg-warning text-dark">Action Required</span>
                                            break;
                                        case PropLink.Domain.Enums.InspectionStatus.ScheduleFixed:
                                            <span class="badge bg-primary">Schedule Fixed</span>
                                            break;
                                        case PropLink.Domain.Enums.InspectionStatus.InspectionCompleted:
                                            <span class="badge bg-info text-dark">Inspection Completed</span>
                                            break;
                                        case PropLink.Domain.Enums.InspectionStatus.UnderProcessing:
                                            <span class="badge bg-success">Under Processing</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.Status</span>
                                            break;
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        @if (item.Status == PropLink.Domain.Enums.InspectionStatus.PendingAgentSchedule || item.Status == PropLink.Domain.Enums.InspectionStatus.ScheduleFixed)
                                        {
                                            <button type="button" class="btn btn-sm btn-primary fw-semibold rounded-pill px-3" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#fixScheduleModal" 
                                                    data-booking-id="@item.BookingId"
                                                    data-property-title="@item.PropertyTitle"
                                                    data-preferred-date="@item.PreferredDate.ToString("yyyy-MM-ddTHH:mm")">
                                                <i class="bi bi-calendar-event me-1"></i> Fix Schedule
                                            </button>
                                        }

                                        @if (item.Status == PropLink.Domain.Enums.InspectionStatus.ScheduleFixed)
                                        {
                                            <form asp-controller="Agent" asp-action="MarkConducted" method="post" class="d-inline ms-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@item.BookingId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3" title="Mark inspection as conducted on-site">
                                                    <i class="bi bi-check2-all me-1"></i> Attended
                                                </button>
                                            </form>
                                        }

                                        @if (item.Status == PropLink.Domain.Enums.InspectionStatus.InspectionCompleted)
                                        {
                                            <!-- Option 1: Sold -->
                                            <button type="button" class="btn btn-sm btn-success fw-bold rounded-pill px-3" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#markSoldModal" 
                                                    data-booking-id="@item.BookingId"
                                                    data-property-title="@item.PropertyTitle"
                                                    data-selling-price="@(item.OfferedPrice.HasValue ? item.OfferedPrice.Value.ToString("F0") : item.AskingPrice.ToString("F0"))"
                                                    title="Both parties agree & documents verified: Mark Sold Out">
                                                <i class="bi bi-check-circle-fill me-1"></i> Sold
                                            </button>

                                            <!-- Option 2: Not Sold -->
                                            <form asp-controller="Agent" asp-action="MarkNotSold" method="post" class="d-inline ms-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@item.BookingId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" 
                                                        onclick="return confirm('Mark this inspection as Not Sold? This will remove the block on this property and allow new buyers to make requests again.');"
                                                        title="Deal not closed: remove block and allow other buyers to request">
                                                    <i class="bi bi-x-circle me-1"></i> Not Sold
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-calendar-x text-muted display-4"></i>
                </div>
                <h5 class="fw-bold text-dark">No Inspection Requests In Queue</h5>
                <p class="text-muted small mb-0">Incoming buyer inspection requests and price offers will appear here for you to schedule.</p>
            </div>
        }
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: AGENT FIXES INSPECTION SCHEDULE -->
<!-- ========================================== -->
<div class="modal fade" id="fixScheduleModal" tabindex="-1" aria-labelledby="fixScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white p-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-check-fill fs-4"></i>
                    <h5 class="modal-title fw-bold text-white mb-0" id="fixScheduleModalLabel">Set Official Inspection Schedule</h5>
                </div>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Agent" asp-action="FixSchedule" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BookingId" id="modalBookingId" />

                <div class="modal-body p-4">
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="small text-muted">Property:</div>
                        <div class="fw-bold text-dark fs-6 text-truncate" id="modalPropertyTitle">...</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Confirmed Date & Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="ScheduledDateTime" id="modalScheduledDateTime" class="form-control form-control-custom" required />
                        <div class="form-text small text-muted">Set the exact appointment time you will join the buyer & seller on-site.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Meeting Point & On-Site Instructions</label>
                        <textarea name="MeetingLocationNotes" class="form-control form-control-custom" rows="3" placeholder="e.g. Meet in front of main entrance gate at 3:00 PM. Please have original NID ready for verification."></textarea>
                    </div>

                    <div class="p-3 rounded-3 bg-primary-subtle border border-primary-subtle text-primary-emphasis small">
                        <i class="bi bi-info-circle-fill me-1"></i> As the Verification Agent, your presence at the physical inspection ensures deed authenticity and prevents off-platform fraud.
                    </div>
                </div>

                <div class="modal-footer border-top bg-light p-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Fix & Confirm Schedule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Mark Property Sold -->
<div class="modal fade" id="markSoldModal" tabindex="-1" aria-labelledby="markSoldModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="Agent" asp-action="MarkSold" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" id="soldModalBookingId" />

                <div class="modal-header border-bottom p-4 bg-success-subtle">
                    <h5 class="modal-title fw-bold text-success" id="markSoldModalLabel">
                        <i class="bi bi-patch-check-fill me-2"></i> Finalize Sale & Mark Sold Out
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="small text-muted">Property:</div>
                        <div class="fw-bold text-dark fs-6 text-truncate" id="soldModalPropertyTitle">...</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Final Confirmed Selling Price ($) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">$</span>
                            <input type="number" name="sellingPrice" id="soldModalSellingPrice" class="form-control form-control-custom" required min="1" step="1" />
                        </div>
                        <div class="form-text small text-muted">This confirmed price will be recorded and displayed with the "Sold Out" badge in the marketplace.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Agent Remarks / Settlement Notes</label>
                        <textarea name="remarks" class="form-control form-control-custom" rows="2" placeholder="e.g. Title deed verified, deed agreement signed by both buyer and seller."></textarea>
                    </div>

                    <div class="p-3 rounded-3 bg-success-subtle border border-success-subtle text-success-emphasis small">
                        <i class="bi bi-shield-lock-fill me-1"></i> Both parties agree & documents are verified. This will mark the listing as <strong>Sold Out</strong>.
                    </div>
                </div>

                <div class="modal-footer border-top bg-light p-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Confirm & Mark Sold
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('fixScheduleModal');
            if (modalEl) {
                modalEl.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const bookingId = button.getAttribute('data-booking-id');
                    const title = button.getAttribute('data-property-title');
                    const preferred = button.getAttribute('data-preferred-date');

                    document.getElementById('modalBookingId').value = bookingId;
                    document.getElementById('modalPropertyTitle').textContent = title;
                    if (preferred) {
                        document.getElementById('modalScheduledDateTime').value = preferred;
                    }
                });
            }

            const soldModalEl = document.getElementById('markSoldModal');
            if (soldModalEl) {
                soldModalEl.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const bookingId = button.getAttribute('data-booking-id');
                    const title = button.getAttribute('data-property-title');
                    const price = button.getAttribute('data-selling-price');

                    document.getElementById('soldModalBookingId').value = bookingId;
                    document.getElementById('soldModalPropertyTitle').textContent = title;
                    if (price) {
                        document.getElementById('soldModalSellingPrice').value = price;
                    }
                });
            }
        });
    </script>
}

@model PropLink.Web.Models.PropertyDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="property-details-page py-5">
    <div class="container py-3">
        <!-- Breadcrumb & Actions -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Property" asp-action="Index" class="text-decoration-none text-muted">Verified Properties</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">@Model.Title</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <button type="button" 
                        class="btn btn-sm btn-outline-custom btn-compare-toggle d-flex align-items-center gap-1"
                        data-property-id="@Model.Id"
                        data-property-title="@Model.Title"
                        data-property-price="@Model.FormattedPrice"
                        data-property-img="@(Model.ImageUrls.FirstOrDefault() ?? "")"
                        data-property-type="@Model.PropertyType"
                        data-property-city="@Model.City"
                        data-default-class="btn-outline-custom">
                    <i class="bi bi-plus-circle me-1"></i>
                    <span>+ Compare</span>
                </button>
                <a asp-controller="Property" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Catalog
                </a>
            </div>
        </div>

        @if (TempData["ToastMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["ToastMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Left Column: Gallery & Details -->
            <div class="col-lg-8">
                <!-- Gallery Section -->
                <div class="property-gallery-card card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
                    <div id="propertyGalleryCarousel" class="carousel slide" data-bs-ride="false">
                        <div class="carousel-inner">
                            @for (int i = 0; i < Model.ImageUrls.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@Model.ImageUrls[i]" class="d-block w-100 property-gallery-main-img" alt="@Model.Title" style="height: 480px; object-fit: cover;" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80';" />
                                </div>
                            }
                        </div>
                        @if (Model.ImageUrls.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#propertyGalleryCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#propertyGalleryCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        }
                    </div>

                    @if (Model.ImageUrls.Count > 1)
                    {
                        <div class="p-3 d-flex gap-2 overflow-auto bg-light border-top">
                            @for (int i = 0; i < Model.ImageUrls.Count; i++)
                            {
                                <img src="@Model.ImageUrls[i]" class="rounded-3 gallery-thumb-img border" style="width: 80px; height: 60px; object-fit: cover; cursor: pointer;" onclick="$('#propertyGalleryCarousel').carousel(@i);" alt="Thumbnail" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80';" />
                            }
                        </div>
                    }
                </div>

                <!-- Property Information -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge badge-verified">
                                    <i class="bi bi-patch-check-fill me-1"></i> Legal Title Verified
                                </span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    @Model.PropertyType
                                </span>
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    Status: @Model.TransactionStatus
                                </span>
                            </div>
                            <h1 class="h3 fw-bold mb-1 text-dark">@Model.Title</h1>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.Address, @Model.City, @Model.State @Model.ZipCode
                            </p>
                        </div>
                        <div class="text-lg-end">
                            <span class="text-muted small d-block">Listing Price</span>
                            <span class="h2 fw-bolder text-primary mb-0">@Model.FormattedPrice</span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Key Metrics Grid -->
                    <h5 class="fw-bold mb-3">Property Overview</h5>
                    <div class="row g-3 text-center mb-4">
                        <div class="col-sm-3 col-6">
                            <div class="p-3 bg-light rounded-4 border">
                                <i class="bi bi-door-open fs-3 text-primary mb-1 d-block"></i>
                                <span class="fw-bold fs-5 d-block">@Model.Bedrooms</span>
                                <span class="small text-muted">Bedrooms</span>
                            </div>
                        </div>
                        <div class="col-sm-3 col-6">
                            <div class="p-3 bg-light rounded-4 border">
                                <i class="bi bi-water fs-3 text-primary mb-1 d-block"></i>
                                <span class="fw-bold fs-5 d-block">@Model.Bathrooms</span>
                                <span class="small text-muted">Bathrooms</span>
                            </div>
                        </div>
                        <div class="col-sm-3 col-6">
                            <div class="p-3 bg-light rounded-4 border">
                                <i class="bi bi-bounding-box-circles fs-3 text-primary mb-1 d-block"></i>
                                <span class="fw-bold fs-5 d-block">@Model.SquareFeet.ToString("N0")</span>
                                <span class="small text-muted">Square Feet</span>
                            </div>
                        </div>
                        <div class="col-sm-3 col-6">
                            <div class="p-3 bg-light rounded-4 border">
                                <i class="bi bi-building-check fs-3 text-primary mb-1 d-block"></i>
                                <span class="fw-bold fs-5 d-block">@Model.PropertyType</span>
                                <span class="small text-muted">Property Type</span>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3">Description</h5>
                    <div class="text-muted lh-lg mb-4" style="white-space: pre-line;">
                        @Model.Description
                    </div>

                    <div class="trust-guarantee-banner p-3 rounded-4 bg-success-subtle border border-success-subtle d-flex align-items-center gap-3">
                        <div class="text-success fs-2 flex-shrink-0">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-success mb-1">PropLink Audit & Document Guarantee</h6>
                            <p class="small text-muted mb-0">
                                This property's seller identity and municipal ownership deed have been examined and audited by our compliance administrator.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Seller & Contact Actions -->
            <div class="col-lg-4">
                <!-- Verified Seller Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white sticky-top" style="top: 100px;">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="seller-avatar bg-primary text-white fs-4 fw-bold" style="width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            @(string.IsNullOrEmpty(Model.SellerName) ? "S" : Model.SellerName.Substring(0, 1))
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-1">
                                <h6 class="fw-bold mb-0">@Model.SellerName</h6>
                                <i class="bi bi-patch-check-fill text-success" title="Identity Verified"></i>
                            </div>
                            <span class="small text-muted">Verified Property Owner</span>
                        </div>
                    </div>

                    <ul class="list-unstyled small text-muted border-top border-bottom py-3 mb-4">
                        <li class="mb-2 d-flex justify-content-between">
                            <span><i class="bi bi-calendar3 me-2 text-primary"></i>Member Since:</span>
                            <span class="fw-semibold text-dark">@Model.SellerMemberSince.ToString("MMM yyyy")</span>
                        </li>
                        <li class="mb-2 d-flex justify-content-between">
                            <span><i class="bi bi-building me-2 text-primary"></i>Active Listings:</span>
                            <span class="fw-semibold text-dark">@Model.SellerTotalProperties Verified</span>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="mb-2 d-flex justify-content-between">
                                <span><i class="bi bi-envelope me-2 text-primary"></i>Email:</span>
                                <span class="fw-semibold text-dark">@Model.SellerEmail</span>
                            </li>
                            @if (!string.IsNullOrEmpty(Model.SellerPhone))
                            {
                                <li class="d-flex justify-content-between">
                                    <span><i class="bi bi-telephone me-2 text-primary"></i>Phone:</span>
                                    <span class="fw-semibold text-dark">@Model.SellerPhone</span>
                                </li>
                            }
                        }
                    </ul>

                    @if (Model.ActiveAuction != null)
                    {
                        <!-- ========================================== -->
                        <!-- LIVE AUCTION PANEL -->
                        <!-- ========================================== -->
                        <div class="auction-live-card card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white border-top border-4 @(Model.ActiveAuction.IsActive ? "border-danger" : "border-warning")">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                @if (Model.ActiveAuction.IsActive)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-danger rounded-pill px-3 py-2 d-flex align-items-center gap-2 shadow-sm animate-pulse-slow">
                                            <span class="spinner-grow spinner-grow-sm text-white" role="status" style="width: 8px; height: 8px;"></span>
                                            <span class="fw-bold text-uppercase tracking-wider">Live Auction</span>
                                        </span>
                                        <span class="badge bg-light text-dark border small">Fixed Duration</span>
                                    </div>
                                }
                                else if (Model.ActiveAuction.IsAwaitingConfirmation)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2 d-flex align-items-center gap-1 shadow-sm">
                                        <i class="bi bi-hourglass-split"></i>
                                        <span class="fw-bold">Awaiting Seller Decision</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">
                                        <span class="fw-bold">Auction @Model.ActiveAuction.Status</span>
                                    </span>
                                }

                                <span class="small text-muted fw-semibold">
                                    <i class="bi bi-people me-1"></i>@Model.ActiveAuction.TotalBidsCount Bids Placed
                                </span>
                            </div>

                            <!-- Live Price Display -->
                            <div class="p-3 rounded-4 bg-light mb-3">
                                <div class="small text-muted mb-1 d-flex justify-content-between">
                                    <span>@(Model.ActiveAuction.CurrentHighestBid.HasValue ? "Current Leading Bid" : "Starting Floor Price")</span>
                                    @if (Model.ActiveAuction.CurrentHighestBid.HasValue)
                                    {
                                        <span class="text-decoration-line-through text-muted small">Floor: @Model.ActiveAuction.FormattedStartPrice</span>
                                    }
                                </div>
                                <div class="d-flex align-items-baseline gap-2">
                                    <h3 class="h2 fw-bold text-danger mb-0">@Model.ActiveAuction.FormattedCurrentHighestBid</h3>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">USD</span>
                                </div>
                                <div class="mt-2 pt-2 border-top d-flex justify-content-between text-muted small">
                                    <span>Min. Increment: <strong class="text-dark">@Model.ActiveAuction.FormattedMinIncrement</strong></span>
                                    <span>Next Min Bid: <strong class="text-emerald">@Model.ActiveAuction.FormattedNextMinimumBid</strong></span>
                                </div>
                            </div>

                            <!-- Countdown Timer -->
                            <div class="auction-timer-card p-3 rounded-4 text-center mb-3 @(Model.ActiveAuction.IsActive ? "bg-dark text-white" : "bg-warning-subtle text-dark border border-warning-subtle")">
                                @if (Model.ActiveAuction.IsActive)
                                {
                                    <div class="small text-white-50 mb-1"><i class="bi bi-stopwatch me-1 text-warning"></i> Time Remaining Before Fixed Close</div>
                                    <div class="display-6 fw-bold text-warning font-monospace countdown-display" id="auctionCountdown" data-end-time="@Model.ActiveAuction.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                                        Calculating...
                                    </div>
                                    <div class="small text-white-50 mt-1">Closes: @Model.ActiveAuction.EndTime.ToString("MMM dd, yyyy HH:mm") UTC (No extension)</div>
                                }
                                else if (Model.ActiveAuction.IsAwaitingConfirmation)
                                {
                                    <div class="fw-bold text-warning mb-1"><i class="bi bi-clock-history me-1"></i> Auction Period Concluded</div>
                                    <div class="small text-muted">Fixed timer elapsed. The verified owner is now reviewing the highest submitted bid.</div>
                                }
                                else
                                {
                                    <div class="fw-bold text-secondary mb-1">Auction Concluded</div>
                                    <div class="small text-muted">Ended at @Model.ActiveAuction.EndTime.ToString("MMM dd, yyyy HH:mm") UTC</div>
                                }
                            </div>

                            <!-- Bidder Alert Banners -->
                            @if (Model.ActiveAuction.IsViewerHighestBidder)
                            {
                                <div class="alert alert-success d-flex align-items-center gap-2 p-3 rounded-4 shadow-sm mb-3">
                                    <i class="bi bi-trophy-fill fs-4 text-success flex-shrink-0"></i>
                                    <div class="small">
                                        <strong>You are the highest bidder!</strong>
                                        @if (Model.ActiveAuction.IsAwaitingConfirmation)
                                        {
                                            <span>Your winning bid of @Model.ActiveAuction.FormattedCurrentHighestBid is currently awaiting seller confirmation.</span>
                                        }
                                        else
                                        {
                                            <span>You are currently leading this live auction.</span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Actions / Bid Input Form -->
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                @if (Model.IsOwner)
                                {
                                    <div class="alert alert-info small mb-3 rounded-4">
                                        <i class="bi bi-info-circle me-1"></i> You are the verified seller of this auctioned property. You cannot bid on your own listing.
                                    </div>
                                    <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-custom w-100 mb-2">
                                        <i class="bi bi-speedometer2 me-1"></i> Manage in Seller Dashboard
                                    </a>
                                }
                                else if (Model.ActiveAuction.IsActive)
                                {
                                    <form asp-controller="Property" asp-action="PlaceBid" asp-route-id="@Model.Id" method="post" class="mb-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="PropertyId" value="@Model.Id" />
                                        <input type="hidden" name="AuctionId" value="@Model.ActiveAuction.AuctionId" />

                                        <label class="form-label small fw-bold mb-1">Enter Your Bid ($ USD)</label>
                                        <div class="input-group mb-2">
                                            <span class="input-group-text bg-light fw-bold">$</span>
                                            <input type="number" 
                                                   name="Amount" 
                                                   id="bidAmountInput" 
                                                   class="form-control form-control-custom fw-bold fs-5 text-danger" 
                                                   value="@Model.ActiveAuction.NextMinimumBid" 
                                                   min="@Model.ActiveAuction.NextMinimumBid" 
                                                   step="@Model.ActiveAuction.MinIncrement" 
                                                   required />
                                        </div>

                                        <!-- Quick increment chips -->
                                        <div class="d-flex gap-1 mb-3">
                                            <button type="button" class="btn btn-sm btn-light border flex-fill quick-bid-btn" data-add="1000">+ $1,000</button>
                                            <button type="button" class="btn btn-sm btn-light border flex-fill quick-bid-btn" data-add="5000">+ $5,000</button>
                                            <button type="button" class="btn btn-sm btn-light border flex-fill quick-bid-btn" data-add="10000">+ $10,000</button>
                                        </div>

                                        <button type="submit" class="btn btn-danger w-100 py-3 fw-bold rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2">
                                            <i class="bi bi-hammer"></i>
                                            <span>Place Live Bid</span>
                                        </button>
                                    </form>
                                }
                                else if (Model.ActiveAuction.IsAwaitingConfirmation)
                                {
                                    <div class="alert alert-warning small rounded-4 mb-2">
                                        <i class="bi bi-hourglass-split me-1"></i> Bidding has closed. Awaiting seller confirmation to finalize agreement.
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center p-3 bg-light rounded-4 mb-3">
                                    <p class="small text-muted mb-2">Sign in with an authenticated buyer account to submit live bids.</p>
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary-custom w-100 rounded-pill">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Place Bid
                                    </a>
                                </div>
                            }

                            <!-- Bid History Accordion -->
                            <div class="accordion accordion-flush mt-2" id="bidHistoryAccordion">
                                <div class="accordion-item border rounded-3 overflow-hidden">
                                    <h2 class="accordion-header" id="headingBids">
                                        <button class="accordion-button collapsed py-2 px-3 small fw-semibold bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBids" aria-expanded="false" aria-controls="collapseBids">
                                            <i class="bi bi-clock-history me-2 text-primary"></i> Live Bid History (@Model.ActiveAuction.BidHistory.Count)
                                        </button>
                                    </h2>
                                    <div id="collapseBids" class="accordion-collapse collapse" aria-labelledby="headingBids" data-bs-parent="#bidHistoryAccordion">
                                        <div class="accordion-body p-2" style="max-height: 250px; overflow-y: auto;">
                                            @if (Model.ActiveAuction.BidHistory.Any())
                                            {
                                                <ul class="list-group list-group-flush small" id="bidHistoryList">
                                                    @foreach (var bid in Model.ActiveAuction.BidHistory)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center px-2 py-2 @(bid.IsViewer ? "bg-success-subtle border-start border-3 border-success" : "")">
                                                            <div>
                                                                <div class="fw-bold @(bid.IsViewer ? "text-success" : "text-dark")">
                                                                    @bid.BidderDisplay
                                                                    @if (bid.IsFromDirectOffer)
                                                                    {
                                                                        <span class="badge bg-info-subtle text-info border border-info-subtle ms-1" style="font-size: 0.65rem;">Direct Offer</span>
                                                                    }
                                                                </div>
                                                                <div class="text-muted" style="font-size: 0.75rem;">@bid.FormattedPlacedAt</div>
                                                            </div>
                                                            <span class="fw-bold fs-6 text-danger">@bid.FormattedAmount</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <div class="text-center text-muted small py-3">
                                                    No bids placed yet. Be the first to bid!
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- STANDARD PROPERTY BUY & INQUIRY ACTIONS -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (Model.IsOwner)
                            {
                                <div class="alert alert-info small mb-3 rounded-4">
                                    <i class="bi bi-info-circle me-1"></i> You are the verified owner of this listing.
                                </div>

                                @if (Model.CanRequestBidding)
                                {
                                    <button type="button" class="btn btn-danger w-100 py-3 mb-2 fw-bold d-flex align-items-center justify-content-center gap-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#requestBiddingModal">
                                        <i class="bi bi-lightning-charge-fill"></i>
                                        <span>Enable Live Bidding / Auction</span>
                                    </button>
                                }
                                else if (Model.HasPendingBiddingRequest)
                                {
                                    <div class="alert alert-warning small mb-3 rounded-4 d-flex align-items-center gap-2">
                                        <i class="bi bi-hourglass-split fs-5"></i>
                                        <span>Bidding request submitted & pending administrator audit.</span>
                                    </div>
                                }

                                <a asp-controller="Property" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100 mb-2 rounded-pill">
                                    <i class="bi bi-pencil-square me-1"></i> Edit Property Details
                                </a>
                            }
                            else
                            {
                                <!-- Acquisition / Booking Action -->
                                <button type="button" class="btn btn-primary-custom w-100 py-3 mb-2 fw-bold d-flex align-items-center justify-content-center gap-2 rounded-pill" data-bs-toggle="modal" data-bs-target="#buyModal">
                                    <i class="bi bi-bag-check-fill"></i>
                                    <span>Place Purchase Agreement</span>
                                </button>

                                <!-- Direct Seller Inquiry Modal Trigger -->
                                <button type="button" class="btn btn-outline-custom w-100 py-2 mb-2 d-flex align-items-center justify-content-center gap-2 rounded-pill" data-bs-toggle="modal" data-bs-target="#inquireModal">
                                    <i class="bi bi-chat-text"></i>
                                    <span>Send Direct Inquiry</span>
                                </button>

                                <!-- Compare Button in Sidebar -->
                                <button type="button" 
                                        class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-pill btn-compare-toggle"
                                        data-property-id="@Model.Id"
                                        data-property-title="@Model.Title"
                                        data-property-price="@Model.FormattedPrice"
                                        data-property-img="@(Model.ImageUrls.FirstOrDefault() ?? "")"
                                        data-property-type="@Model.PropertyType"
                                        data-property-city="@Model.City"
                                        data-default-class="btn-outline-secondary">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>+ Compare Property</span>
                                </button>
                            }
                        }
                        else
                        {
                            <div class="text-center p-3 bg-light rounded-4">
                                <p class="small text-muted mb-3">Sign in to contact this verified seller or register a purchase agreement.</p>
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary-custom w-100 mb-2 rounded-pill">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Inquire
                                </a>
                                <button type="button" 
                                        class="btn btn-outline-custom w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-pill btn-compare-toggle"
                                        data-property-id="@Model.Id"
                                        data-property-title="@Model.Title"
                                        data-property-price="@Model.FormattedPrice"
                                        data-property-img="@(Model.ImageUrls.FirstOrDefault() ?? "")"
                                        data-property-type="@Model.PropertyType"
                                        data-property-city="@Model.City"
                                        data-default-class="btn-outline-custom">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>+ Add to Comparator</span>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODALS -->
<!-- ========================================== -->

<!-- REQUEST BIDDING MODAL -->
<div class="modal fade" id="requestBiddingModal" tabindex="-1" aria-labelledby="requestBiddingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="requestBiddingModalLabel">
                    <i class="bi bi-lightning-charge-fill text-danger me-2"></i>Request Live Auction Permission
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Property" asp-action="RequestBidding" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PropertyId" value="@Model.Id" />
                <div class="modal-body py-3">
                    <p class="small text-muted mb-3">
                        Submit a request to activate live competitive bidding for <strong>@Model.Title</strong>. An administrator will review and launch the fixed-duration auction.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Auction Starting Price ($ USD)</label>
                        <input type="number" name="StartPrice" class="form-control form-control-custom fw-bold text-danger" value="@Model.Price" min="1000" step="100" required />
                        <span class="small text-muted">Prefilled with current verified listing price.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Minimum Bid Increment ($ USD)</label>
                        <input type="number" name="MinIncrement" class="form-control form-control-custom" value="1000" min="100" step="100" required />
                        <span class="small text-muted">Minimum increase required per subsequent bid.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Fixed Auction Duration</label>
                        <select name="DurationHours" class="form-select form-control-custom">
                            <option value="6">6 Hours (Flash Auction)</option>
                            <option value="12">12 Hours (Half-Day)</option>
                            <option value="24" selected>24 Hours (1 Day)</option>
                            <option value="48">48 Hours (2 Days)</option>
                            <option value="72">72 Hours (3 Days)</option>
                        </select>
                        <span class="small text-muted">Note: Fixed end time never moves or extends on late bids.</span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                        <i class="bi bi-send me-1"></i> Submit Bidding Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Buy Agreement Modal -->
<div class="modal fade" id="buyModal" tabindex="-1" aria-labelledby="buyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="buyModalLabel"><i class="bi bi-shield-check text-success me-2"></i>Initiate Purchase Agreement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Property" asp-action="Buy" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-3">
                    <p class="small text-muted mb-3">
                        You are expressing formal interest to purchase <strong>@Model.Title</strong>. This agreement will be added to your <strong>Buying History</strong> with deed-verified authenticity.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Agreed Offer Price ($)</label>
                        <input type="number" name="offerPrice" class="form-control form-control-custom" value="@Model.Price" min="1000" step="100" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Notes / Agreement Conditions (Optional)</label>
                        <textarea name="notes" class="form-control form-control-custom" rows="3" placeholder="Specify preferred closing date, mortgage pre-approval status, or inspection timeline..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom px-4 fw-bold rounded-pill">
                        <i class="bi bi-check2-circle me-1"></i> Confirm Agreement
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Inquire Modal -->
<div class="modal fade" id="inquireModal" tabindex="-1" aria-labelledby="inquireModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="inquireModalLabel"><i class="bi bi-chat-left-dots text-primary me-2"></i>Inquire about this Property</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Property" asp-action="Inquire" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Your Message to Seller</label>
                        <textarea name="message" class="form-control form-control-custom" rows="4" placeholder="Hi @Model.SellerName, I'm interested in @Model.Title and would like to schedule a private walkthrough..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Contact Phone Number (Optional)</label>
                        <input type="tel" name="contactPhone" class="form-control form-control-custom" placeholder="+1-555-0199" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom px-4 fw-bold rounded-pill">
                        <i class="bi bi-send me-1"></i> Send Inquiry
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Quick Bid Increment buttons
            document.querySelectorAll('.quick-bid-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const addAmount = parseFloat(this.getAttribute('data-add')) || 0;
                    const input = document.getElementById('bidAmountInput');
                    if (input) {
                        const currentVal = parseFloat(input.value) || 0;
                        input.value = currentVal + addAmount;
                    }
                });
            });

            // Live Auction Countdown Timer
            const countdownEl = document.getElementById('auctionCountdown');
            if (countdownEl) {
                const endTimeStr = countdownEl.getAttribute('data-end-time');
                if (endTimeStr) {
                    const endTime = new Date(endTimeStr).getTime();

                    function updateCountdown() {
                        const now = new Date().getTime();
                        const distance = endTime - now;

                        if (distance <= 0) {
                            countdownEl.innerHTML = '<span class="text-danger">AUCTION ENDED</span>';
                            return;
                        }

                        const hours = Math.floor(distance / (1000 * 60 * 60));
                        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                        const formatted = (hours > 0 ? hours + 'h ' : '') + 
                                          String(minutes).padStart(2, '0') + 'm ' + 
                                          String(seconds).padStart(2, '0') + 's';

                        countdownEl.textContent = formatted;
                    }

                    updateCountdown();
                    setInterval(updateCountdown, 1000);
                }
            }
        });
    </script>
}


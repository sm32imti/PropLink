<!-- REQUEST BIDDING MODAL -->
<div class="modal fade" id="requestBiddingModal" tabindex="-1" aria-labelledby="requestBiddingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="requestBiddingModalLabel">
                    <i class="bi bi-lightning-charge-fill text-danger me-2"></i>Request Live Auction Permission
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Property" asp-action="RequestBidding" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PropertyId" value="@Model.Id" />
                <div class="modal-body py-3">
                    <p class="small text-muted mb-3">
                        Submit a request to activate live competitive bidding for <strong>@Model.Title</strong>. An administrator will review and launch the fixed-duration auction.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Auction Starting Price ($ USD)</label>
                        <input type="number" name="StartPrice" class="form-control form-control-custom fw-bold text-danger" value="@Model.Price" min="1000" step="100" required />
                        <span class="small text-muted">Prefilled with current verified listing price.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Minimum Bid Increment ($ USD)</label>
                        <input type="number" name="MinIncrement" class="form-control form-control-custom" value="1000" min="100" step="100" required />
                        <span class="small text-muted">Minimum increase required per subsequent bid.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Fixed Auction Duration</label>
                        <select name="DurationHours" class="form-select form-control-custom">
                            <option value="6">6 Hours (Flash Auction)</option>
                            <option value="12">12 Hours (Half-Day)</option>
                            <option value="24" selected>24 Hours (1 Day)</option>
                            <option value="48">48 Hours (2 Days)</option>
                            <option value="72">72 Hours (3 Days)</option>
                        </select>
                        <span class="small text-muted">Note: Fixed end time never moves or extends on late bids.</span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                        <i class="bi bi-send me-1"></i> Submit Bidding Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


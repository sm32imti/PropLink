<!-- AGENT INSPECTION & PRICE OFFER MODAL -->
<!-- ========================================== -->
<div class="modal fade" id="inspectionModal" tabindex="-1" aria-labelledby="inspectionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-white bg-opacity-25 rounded-3">
                        <i class="bi bi-calendar2-check-fill fs-3 text-white"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="inspectionModalLabel">Schedule On-Site Deed Inspection</h5>
                        <p class="small mb-0 text-white-50">Assisted on-site by an official PropLink Verification Agent</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Inspection" asp-action="RequestInspection" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PropertyId" value="@Model.Id" />
                <input type="hidden" name="PropertyTitle" value="@Model.Title" />
                <input type="hidden" name="AskingPrice" value="@Model.Price" />

                <div class="modal-body p-4">
                    <!-- Property Info Banner -->
                    <div class="p-3 bg-light rounded-3 border mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <div class="fw-bold text-dark fs-6">@Model.Title</div>
                            <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@Model.Address, @Model.City, @Model.State</div>
                        </div>
                        <div class="text-end">
                            <span class="small text-muted d-block">Listed Asking Price:</span>
                            <span class="fw-bold text-primary fs-5">@Model.FormattedPrice</span>
                        </div>
                    </div>

                    <!-- Path Selector (Radio Cards) -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-dark mb-2">Select Your Inspection Intent:</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="card border p-3 rounded-3 h-100 cursor-pointer" for="typeAsking" style="cursor: pointer;">
                                    <div class="d-flex align-items-start gap-2">
                                        <input type="radio" name="InspectionType" id="typeAsking" value="DirectAskingPrice" class="form-check-input mt-1" checked onchange="toggleOfferInput()" />
                                        <div>
                                            <div class="fw-bold text-dark">Accept Asking Price</div>
                                            <div class="small text-muted">Accept listed price (@Model.FormattedPrice) and request physical inspection.</div>
                                        </div>
                                    </div>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="card border p-3 rounded-3 h-100 cursor-pointer" for="typeOffer" style="cursor: pointer;">
                                    <div class="d-flex align-items-start gap-2">
                                        <input type="radio" name="InspectionType" id="typeOffer" value="PriceOfferWithInspection" class="form-check-input mt-1" onchange="toggleOfferInput()" />
                                        <div>
                                            <div class="fw-bold text-dark">Submit Price Offer + Inspection</div>
                                            <div class="small text-muted">Propose a custom price offer and inspect deed papers with agent.</div>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Custom Price Offer Input (Revealed on Path 2) -->
                    <div class="mb-3 d-none" id="customOfferSection">
                        <label class="form-label small fw-bold text-dark">Your Proposed Price Offer ($ USD) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white fw-bold">$</span>
                            <input type="number" name="OfferedPrice" id="offeredPriceInput" class="form-control form-control-custom fw-bold fs-5 text-success" placeholder="e.g. @((Model.Price * 0.95m).ToString("0"))" min="1" step="1000" />
                        </div>
                        <div class="form-text small text-muted">The seller will review your offer before the on-site deed inspection is confirmed.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Preferred Date <span class="text-danger">*</span></label>
                            <input type="date" name="PreferredDate" class="form-control form-control-custom" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Preferred Time Window <span class="text-danger">*</span></label>
                            <select name="PreferredTimeSlot" class="form-select form-control-custom" required>
                                <option value="Morning (10:00 AM - 1:00 PM)">Morning (10:00 AM - 1:00 PM)</option>
                                <option value="Afternoon (2:00 PM - 5:00 PM)" selected>Afternoon (2:00 PM - 5:00 PM)</option>

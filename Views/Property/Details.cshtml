<!-- FRAUD REPORT MODAL (WITH PROOF ATTACHMENT) -->
<!-- ========================================== -->
<div class="modal fade" id="reportFraudModal" tabindex="-1" aria-labelledby="reportFraudModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-white bg-opacity-25 rounded-3">
                        <i class="bi bi-shield-exclamation fs-3 text-white"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="reportFraudModalLabel">Report Fraud or Suspicious User to Admin</h5>
                        <p class="small mb-0 text-white-50">Submit evidence directly to platform administrators for investigation & ban review</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Profile" asp-action="SubmitReport" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReportedUserId" value="@Model.SellerId" />
                <input type="hidden" name="ReportedUserName" value="@Model.SellerName" />
                <input type="hidden" name="ReportedUserEmail" value="@Model.SellerEmail" />
                <input type="hidden" name="RelatedPropertyId" value="@Model.Id" />
                <input type="hidden" name="RelatedPropertyTitle" value="@Model.Title" />
                <input type="hidden" name="ReturnUrl" value="@Context.Request.Path" />

                <div class="modal-body p-4">
                    <!-- Suspect Profile Summary Banner -->
                    <div class="p-3 rounded-3 bg-light border border-danger-subtle mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="seller-avatar bg-danger text-white fw-bold" style="width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                @(string.IsNullOrEmpty(Model.SellerName) ? "S" : Model.SellerName.Substring(0, 1))
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Suspect: @Model.SellerName</div>
                                <div class="small text-muted">Listing: "@Model.Title" (ID: @Model.Id.ToString().Substring(0, 8)...)</div>
                            </div>
                        </div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Fraud Allegation
                        </span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">
                                Fraud Category <span class="text-danger">*</span>
                            </label>
                            <select name="Category" class="form-select form-control-custom" required>
                                <option value="Fake Title Deed / Document Forgery">Fake Title Deed / Document Forgery</option>
                                <option value="Off-Platform Cash / Wire Payment Scam">Off-Platform Cash / Wire Payment Scam</option>
                                <option value="Identity Theft / False Representation">Identity Theft / False Representation</option>
                                <option value="Phishing / Malicious Communication">Phishing / Malicious Communication</option>
                                <option value="Misleading Specifications / Property Does Not Exist">Misleading Specifications / Property Does Not Exist</option>
                                <option value="Abuse / Harassment / Extortion">Abuse / Harassment / Extortion</option>
                                <option value="Other Suspicious Activity">Other Suspicious Activity</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">
                                Detailed Explanation & Incident Facts <span class="text-danger">*</span>
                            </label>
                            <textarea name="Description" class="form-control form-control-custom" rows="4" placeholder="Describe the suspicious behavior, false claims made by the seller, forged records, or off-platform payment demands in detail..." required minlength="15"></textarea>
                            <div class="form-text small text-muted">Provide specific timelines, messages, or inconsistencies observed.</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">
                                <i class="bi bi-paperclip me-1 text-primary"></i> Attach Evidence Proof (Screenshots, PDFs, Chat Logs, Receipts)
                            </label>
                            <input type="file" name="ProofFile" class="form-control form-control-custom" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx" />
                            <div class="form-text small text-muted">Upload any concrete evidence supporting your report (Max 25MB: PDF, PNG, JPG).</div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 rounded-3 bg-warning-subtle border border-warning-subtle text-warning-emphasis small">
                                <i class="bi bi-info-circle-fill me-1"></i> <strong>Direct Action Policy:</strong> PropLink maintains zero tolerance for real estate fraud. Validated reports will result in an immediate and permanent ban of the offender's account and delisting of all their properties without prior warning.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top bg-light p-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-flag-fill"></i> Submit Fraud Report to Admin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Quick Bid Increment buttons
            document.querySelectorAll('.quick-bid-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const addAmount = parseFloat(this.getAttribute('data-add')) || 0;
                    const input = document.getElementById('bidAmountInput');
                    if (input) {
                        const currentVal = parseFloat(input.value) || 0;
                        input.value = currentVal + addAmount;
                    }
                });
            });

            // Live Auction Countdown Timer
            const countdownEl = document.getElementById('auctionCountdown');
            if (countdownEl) {
                const endTimeStr = countdownEl.getAttribute('data-end-time');
                if (endTimeStr) {
                    const endTime = new Date(endTimeStr).getTime();

                    function updateCountdown() {
                        const now = new Date().getTime();
                        const distance = endTime - now;

                        if (distance <= 0) {
                            countdownEl.innerHTML = '<span class="text-danger">AUCTION ENDED</span>';
                            return;
                        }

                        const hours = Math.floor(distance / (1000 * 60 * 60));
                        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                        const formatted = (hours > 0 ? hours + 'h ' : '') + 
                                          String(minutes).padStart(2, '0') + 'm ' + 
                                          String(seconds).padStart(2, '0') + 's';

                        countdownEl.textContent = formatted;
                    }

                    updateCountdown();
                    setInterval(updateCountdown, 1000);
                }
            }
        });

        function selectInspectionPath(type) {
            if (type === 'DirectAskingPrice') {
                const askingRadio = document.getElementById('typeAsking');
                if (askingRadio) askingRadio.checked = true;
            } else {
                const offerRadio = document.getElementById('typeOffer');
                if (offerRadio) offerRadio.checked = true;
            }
            toggleOfferInput();
        }

        function toggleOfferInput() {
            const offerRadio = document.getElementById('typeOffer');
            const isOffer = offerRadio && offerRadio.checked;
            const offerSection = document.getElementById('customOfferSection');
            const offerInput = document.getElementById('offeredPriceInput');
            if (offerSection && offerInput) {
                if (isOffer) {
                    offerSection.classList.remove('d-none');
                    offerInput.required = true;
                } else {
                    offerSection.classList.add('d-none');
                    offerInput.required = false;
                }
            }
        }
    </script>
}


@model PropLink.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Verified Real Estate Marketplace";
}

<!-- Hero Section with Dynamic Search -->
<section class="hero-section" id="search-section">
    <div class="hero-bg-glow"></div>
    <div class="container position-relative py-5">
        <div class="row align-items-center justify-content-center text-center py-4">
            <div class="col-xl-9 col-lg-10">
                <div class="hero-badge mb-3">
                    <i class="bi bi-shield-fill-check me-1 text-emerald"></i>
                    <span>100% Legal Document & Title Verified Real Estate</span>
                </div>
                <h1 class="hero-title mb-3">
                    Find Real Estate You Can <span class="gradient-text">Actually Trust</span>
                </h1>
                <p class="hero-subtitle mb-4">
                    PropLink audits ownership deeds, tax clearance records, and seller identity before any listing is published. Zero fake listings, zero duplicate brokers.
                </p>

                <!-- Search Card -->
                <div class="hero-search-card text-start">
                    <div class="search-tabs d-flex gap-2 mb-3">
                        <button type="button" class="tab-btn active" data-tab="buy"><i class="bi bi-house-door me-1"></i> Buy</button>
                        <button type="button" class="tab-btn" data-tab="rent"><i class="bi bi-key me-1"></i> Rent</button>
                        <button type="button" class="tab-btn" data-tab="commercial"><i class="bi bi-building me-1"></i> Commercial</button>
                    </div>

                    <form method="get" asp-controller="Property" asp-action="Index" class="search-form row g-2 align-items-center">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label small text-muted mb-1"><i class="bi bi-geo-alt me-1 text-emerald"></i> Location</label>
                            <input type="text" name="city" class="form-control form-control-custom" placeholder="City, neighborhood, or zip..." />
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small text-muted mb-1"><i class="bi bi-building me-1 text-emerald"></i> Property Type</label>
                            <select name="propertyType" class="form-select form-control-custom">
                                <option value="" selected>All Property Types</option>
                                <option value="House">Single Family House</option>
                                <option value="Apartment">Modern Apartment</option>
                                <option value="Condo">Luxury Condo</option>
                                <option value="Townhouse">Townhouse</option>
                                <option value="Commercial">Commercial Space</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small text-muted mb-1"><i class="bi bi-currency-dollar me-1 text-emerald"></i> Max Price</label>
                            <select name="maxPrice" class="form-select form-control-custom">
                                <option value="" selected>Any Price</option>
                                <option value="500000">Up to $500,000</option>
                                <option value="750000">Up to $750,000</option>
                                <option value="1000000">Up to $1,000,000</option>
                                <option value="2000000">Up to $2,000,000+</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6 d-flex align-items-end">
                            <button type="submit" class="btn btn-search w-100 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-search"></i>
                                <span>Search</span>
                            </button>
                        </div>
                    </form>

                    <div class="search-footer-tags mt-3 pt-2 border-top d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-muted fw-semibold me-1">Popular:</span>
                        <a asp-controller="Property" asp-action="Index" asp-route-city="Beverly Hills" class="search-tag"><i class="bi bi-geo-alt me-1"></i>Beverly Hills</a>
                        <a asp-controller="Property" asp-action="Index" asp-route-propertyType="Condo" class="search-tag"><i class="bi bi-building me-1"></i>Condos</a>
                        <a asp-controller="Property" asp-action="Index" asp-route-propertyType="House" class="search-tag"><i class="bi bi-house me-1"></i>Houses</a>
                        <a asp-controller="Property" asp-action="Index" asp-route-propertyType="Apartment" class="search-tag"><i class="bi bi-buildings me-1"></i>Apartments</a>
                        <a asp-controller="Property" asp-action="Index" class="search-tag search-tag-all"><i class="bi bi-arrow-right-short me-1"></i>All Listings &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats & Trust Metrics -->
<section class="stats-section py-4">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-lg-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-patch-check-fill text-emerald"></i></div>
                    <div class="stat-number">@Model.TotalVerifiedListings.ToString("N0")+</div>
                    <div class="stat-label">100% Verified Listings</div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-people-fill text-emerald"></i></div>
                    <div class="stat-number">@Model.ActiveBuyers.ToString("N0")+</div>
                    <div class="stat-label">Active Property Buyers</div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-stopwatch-fill text-emerald"></i></div>
                    <div class="stat-number">&lt; @Model.AverageReviewHours.ToString("0.#") hrs</div>
                    <div class="stat-label">Avg. Admin Title Review</div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-geo-alt-fill text-emerald"></i></div>
                    <div class="stat-number">@Model.TotalCities+</div>
                    <div class="stat-label">Metropolitan Areas</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Discovery & Marketplace Gateway Section (Replaces raw property cards on home page) -->
<section class="gateway-section py-5">
    <div class="container py-3">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="section-pill mb-2 d-inline-block">The Verified Marketplace</span>
            <h2 class="section-title mb-2">Explore Real Estate with Guaranteed Authenticity</h2>
            <p class="section-subtitle">
                Browse our complete catalog of admin-approved properties, or filter by category to find your dream property.
            </p>
        </div>

        <!-- Category Discovery Cards Grid -->
        <div class="row g-4 mb-5">
            <div class="col-lg-3 col-md-6">
                <a asp-controller="Property" asp-action="Index" asp-route-propertyType="House" class="category-card text-decoration-none">
                    <div class="category-icon-wrapper">
                        <i class="bi bi-house-heart"></i>
                    </div>
                    <h4 class="category-title">Single Family Houses</h4>
                    <p class="category-desc">Spacious suburban & luxury family homes with verified deed titles.</p>
                    <div class="category-link">
                        <span>Explore Houses</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>

            <div class="col-lg-3 col-md-6">
                <a asp-controller="Property" asp-action="Index" asp-route-propertyType="Apartment" class="category-card text-decoration-none">
                    <div class="category-icon-wrapper">
                        <i class="bi bi-buildings"></i>
                    </div>
                    <h4 class="category-title">Modern Apartments</h4>
                    <p class="category-desc">Urban living spaces and luxury flats with inspected lease/title proofs.</p>
                    <div class="category-link">
                        <span>Explore Apartments</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>

            <div class="col-lg-3 col-md-6">
                <a asp-controller="Property" asp-action="Index" asp-route-propertyType="Condo" class="category-card text-decoration-none">
                    <div class="category-icon-wrapper">
                        <i class="bi bi-building-check"></i>
                    </div>
                    <h4 class="category-title">Luxury Condos</h4>
                    <p class="category-desc">High-rise condominiums with premium amenities and ownership clearance.</p>
                    <div class="category-link">
                        <span>Explore Condos</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>

            <div class="col-lg-3 col-md-6">
                <a asp-controller="Property" asp-action="Index" asp-route-propertyType="Commercial" class="category-card text-decoration-none">
                    <div class="category-icon-wrapper">
                        <i class="bi bi-briefcase"></i>
                    </div>
                    <h4 class="category-title">Commercial & Office</h4>
                    <p class="category-desc">Prime retail, business hubs, and commercial buildings verified for investment.</p>
                    <div class="category-link">
                        <span>Explore Commercial</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
        </div>

        <!-- Featured Catalog Banner CTA -->
        <div class="catalog-cta-banner p-4 p-lg-5 rounded-4 d-flex flex-column flex-lg-row align-items-center justify-content-between gap-4">
            <div class="d-flex align-items-center gap-3">
                <div class="banner-badge-icon d-none d-sm-flex">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div>
                    <span class="badge bg-emerald-light text-emerald fw-bold mb-2">Curated & Document Verified</span>
                    <h3 class="fw-bold mb-1 banner-heading">Looking for the Complete Verified Catalog?</h3>
                    <p class="mb-0 text-muted">All active listings have verified ownership proofs on file with our compliance team.</p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                <a asp-controller="Property" asp-action="Index" class="btn btn-primary-custom px-4 py-3 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                    <span>Browse All Verified Listings</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- How It Works (Verification Workflow) -->
<section class="how-it-works-section py-5" id="how-it-works">
    <div class="container py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="section-pill mb-2 d-inline-block">The PropLink Standard</span>
            <h2 class="section-title mb-2">How Document Verification Works</h2>
            <p class="section-subtitle">We bridge trust between buyers and sellers through a 3-layer human verification pipeline.</p>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-lg-4 col-md-6">
                <div class="step-card h-100">
                    <div class="step-number">01</div>
                    <div class="step-icon-wrapper">
                        <i class="bi bi-file-earmark-arrow-up"></i>
                    </div>
                    <h4 class="step-title">1. Seller Uploads Listing & Proofs</h4>
                    <p class="step-desc">
                        Sellers create their listing specifications, photo gallery, and securely upload government-issued title deeds, tax receipts, and seller NID/identity documents.
                    </p>
                    <ul class="step-checklist list-unstyled">
                        <li><i class="bi bi-check-circle-fill text-emerald me-2"></i>Title Deed & Land Registration</li>
                        <li><i class="bi bi-check-circle-fill text-emerald me-2"></i>Recent Property Tax Receipts</li>
                        <li><i class="bi bi-check-circle-fill text-emerald me-2"></i>Seller NID / Passport Authentication</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="step-card step-highlight h-100">
                    <div class="step-number">02</div>
                    <div class="step-icon-wrapper highlight">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h4 class="step-title">2. Administrator Reviews & Audits</h4>
                    <p class="step-desc">
                        PropLink compliance administrators audit submitted documents against registry standards, ensuring rightful ownership, correct titles, and zero encumbrances.
                    </p>
                    <ul class="step-checklist list-unstyled">
                        <li><i class="bi bi-check-circle-fill text-emerald me-2"></i>Confidential Document Inspection</li>
                        <li><i class="bi bi-check-circle-fill text-emerald me-2"></i>Fraud & Duplicate Listing Check</li>
                        <li><i class="bi bi-check-circle-fill text-emerald me-2"></i>Average 8.5 hr Turnaround</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="step-card h-100">
                    <div class="step-number">03</div>
                    <div class="step-icon-wrapper">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <h4 class="step-title">3. Verified Listing Goes Live</h4>
                    <p class="step-desc">
                        Once approved by an admin, the listing is published with a verified trust badge. Serious buyers connect directly with verified sellers in full confidence.
                    </p>
                    <ul class="step-checklist list-unstyled">
                        <li><i class="bi bi-check-circle-fill text-emerald me-2"></i>100% Genuine Inquiries</li>
                        <li><i class="bi bi-check-circle-fill text-emerald me-2"></i>Direct Buyer-Seller Purchase Intent</li>
                        <li><i class="bi bi-check-circle-fill text-emerald me-2"></i>Faster Closing Cycles</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Trust Guarantee & Comparison -->
<section class="comparison-section py-5" id="trust-guarantee">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="section-pill mb-2 d-inline-block">The Difference</span>
                <h2 class="section-title mb-3">Why Unverified Listings Cost You Time & Money</h2>
                <p class="text-muted mb-4">
                    Traditional classifieds are crowded with duplicate brokers, misleading photos, and unverified titles. PropLink eliminates the guesswork before you even book a visit.
                </p>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="icon-bubble text-emerald bg-emerald-light"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <h6 class="mb-1 fw-bold heading-text">100% Legal Ownership Verified</h6>
                            <p class="small text-muted mb-0">Documents are reviewed by our administration team before publishing.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="icon-bubble text-emerald bg-emerald-light"><i class="bi bi-eye"></i></div>
                        <div>
                            <h6 class="mb-1 fw-bold heading-text">Transparent Details & History</h6>
                            <p class="small text-muted mb-0">Direct access to square footage, exact address, and verified photos.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="icon-bubble text-emerald bg-emerald-light"><i class="bi bi-chat-heart"></i></div>
                        <div>
                            <h6 class="mb-1 fw-bold heading-text">Direct Seller Communication</h6>
                            <p class="small text-muted mb-0">No endless middlemen or unauthorized brokers hijacking listings.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="comparison-card">
                    <div class="table-responsive">
                        <table class="table comparison-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Feature</th>
                                    <th class="text-center text-danger">Unverified Platforms</th>
                                    <th class="text-center text-emerald bg-emerald-subtle rounded-top">PropLink Platform</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-semibold heading-text">Deed & Title Verification</td>
                                    <td class="text-center text-muted"><i class="bi bi-x-circle-fill text-danger me-1"></i> No Verification</td>
                                    <td class="text-center fw-bold text-emerald bg-emerald-subtle"><i class="bi bi-check-circle-fill text-emerald me-1"></i> Mandatory Audit</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold heading-text">Duplicate Listings</td>
                                    <td class="text-center text-muted"><i class="bi bi-x-circle-fill text-danger me-1"></i> Frequent Spam</td>
                                    <td class="text-center fw-bold text-emerald bg-emerald-subtle"><i class="bi bi-check-circle-fill text-emerald me-1"></i> Zero Duplicates</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold heading-text">Seller ID Validation</td>
                                    <td class="text-center text-muted"><i class="bi bi-x-circle-fill text-danger me-1"></i> Unchecked</td>
                                    <td class="text-center fw-bold text-emerald bg-emerald-subtle"><i class="bi bi-check-circle-fill text-emerald me-1"></i> Identity Verified</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold heading-text">Admin Quality Review</td>
                                    <td class="text-center text-muted"><i class="bi bi-x-circle-fill text-danger me-1"></i> None</td>
                                    <td class="text-center fw-bold text-emerald bg-emerald-subtle rounded-bottom"><i class="bi bi-check-circle-fill text-emerald me-1"></i> Human Review</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Seller Call to Action -->
<section class="seller-cta-section py-5" id="seller-cta">
    <div class="container py-4">
        <div class="seller-cta-card text-center p-5">
            <div class="cta-badge mb-3">
                <i class="bi bi-stars me-1 text-emerald-light"></i> For Property Owners & Sellers
            </div>
            <h2 class="cta-title mb-3">Ready to List Your Property with Verification?</h2>
            <p class="cta-subtitle max-w-700 mx-auto mb-4">
                Listings with the PropLink Verification badge receive 4.5x more inquiries from pre-qualified buyers. Submit your listing and legal documentation in minutes.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-controller="Property" asp-action="Sell" class="btn btn-primary-custom px-4 py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-cloud-arrow-up-fill"></i>
                    <span>Submit Listing & Documents</span>
                </a>
                <a asp-controller="Property" asp-action="Index" class="btn btn-outline-custom px-4 py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Explore Verified Properties</span>
                </a>
            </div>
        </div>
    </div>
</section>

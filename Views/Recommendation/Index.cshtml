@model PropLink.Web.Models.PropertyRecommendationRequestViewModel
@{
    ViewData["Title"] = "Smart Property Recommendation";
}

<div class="recommendation-page py-5">
    <div class="container py-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-3">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Smart Property Recommendation</li>
            </ol>
        </nav>

        <div class="recommendation-heading mb-4">
            <span class="badge badge-trust mb-2"><i class="bi bi-sliders me-1"></i> Property Matching Engine</span>
            <h1 class="h2 fw-bold mb-2">Smart Property Recommendation</h1>
            <p class="text-muted mb-0">Set your priorities to rank verified listings by how closely they fit. Scores use transparent weighted criteria, not an AI prediction.</p>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <form asp-controller="Recommendation" asp-action="Results" method="post" class="recommendation-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <section class="recommendation-form-section p-4 p-md-5">
                        <h2 class="h5 fw-bold mb-1">Your requirements</h2>
                        <p class="text-muted small mb-4">Location and maximum budget are required. Leave other numeric requirements at zero if you have no minimum.</p>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label small fw-bold"></label>
                                <input asp-for="Location" class="form-control form-control-custom" placeholder="City, area, or postal code" autocomplete="address-level2" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MaximumBudget" class="form-label small fw-bold"></label>
                                <input asp-for="MaximumBudget" type="number" step="any" min="1" class="form-control form-control-custom" placeholder="e.g. 8000000" />
                                <span asp-validation-for="MaximumBudget" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PropertyType" class="form-label small fw-bold"></label>
                                <select asp-for="PropertyType" class="form-select form-control-custom">
                                    <option value="">Any type</option>
                                    @foreach (PropLink.Domain.Enums.PropertyType type in Enum.GetValues(typeof(PropLink.Domain.Enums.PropertyType)))
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                                <span asp-validation-for="PropertyType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MinimumBedrooms" class="form-label small fw-bold"></label>
                                <input asp-for="MinimumBedrooms" type="number" min="0" max="50" class="form-control form-control-custom" placeholder="No minimum" />
                                <span asp-validation-for="MinimumBedrooms" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MinimumBathrooms" class="form-label small fw-bold"></label>
                                <input asp-for="MinimumBathrooms" type="number" min="0" max="50" class="form-control form-control-custom" placeholder="No minimum" />
                                <span asp-validation-for="MinimumBathrooms" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MinimumArea" class="form-label small fw-bold">Minimum Area (sq.ft.)</label>
                                <input asp-for="MinimumArea" type="number" min="0" max="100000" step="any" class="form-control form-control-custom" placeholder="No minimum" />
                                <span asp-validation-for="MinimumArea" class="text-danger small"></span>
                            </div>
                        </div>

                        <fieldset class="mt-4 pt-3 border-top">
                            <legend class="h6 fw-bold mb-3">Prioritize these features</legend>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="ParkingRequired" class="form-check-input" role="switch" />
                                        <label asp-for="ParkingRequired" class="form-check-label">Parking required</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="NearSchoolOrUniversity" class="form-check-input" role="switch" />
                                        <label asp-for="NearSchoolOrUniversity" class="form-check-label">Near a school or university</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="NearHospital" class="form-check-input" role="switch" />
                                        <label asp-for="NearHospital" class="form-check-label">Near a hospital</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input asp-for="NearPublicTransport" class="form-check-input" role="switch" />
                                        <label asp-for="NearPublicTransport" class="form-check-label">Near public transport</label>
                                    </div>
                                </div>
                            </div>
                        </fieldset>

                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4 pt-3 border-top">
                            <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i>Results include approved properties only.</span>
                            <button type="submit" class="btn btn-primary-custom px-4 py-2 fw-bold d-inline-flex align-items-center gap-2">
                                <i class="bi bi-search"></i> Find My Best Properties
                            </button>
                        </div>
                    </section>
                </form>
            </div>

            <aside class="col-lg-4">
                <section class="recommendation-weights p-4">
                    <h2 class="h6 fw-bold mb-3">How the match is scored</h2>
                    <ul class="list-unstyled recommendation-weight-list mb-3">
                        <li><span>Budget</span><strong>25%</strong></li>
                        <li><span>Location</span><strong>20%</strong></li>
                        <li><span>Property type</span><strong>10%</strong></li>
                        <li><span>Bedrooms</span><strong>10%</strong></li>
                        <li><span>Bathrooms</span><strong>5%</strong></li>
                        <li><span>Area</span><strong>10%</strong></li>
                        <li><span>Parking</span><strong>5%</strong></li>
                        <li><span>School / university</span><strong>5%</strong></li>
                        <li><span>Hospital</span><strong>5%</strong></li>
                        <li><span>Public transport</span><strong>5%</strong></li>
                    </ul>
                    <p class="small text-muted mb-0">Numeric minimums can earn partial credit. Requested amenity details that are not recorded are left out of the score; each result shows its data coverage.</p>
                </section>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model PropLink.Web.Models.PropertyRecommendationResultsViewModel
@{
    ViewData["Title"] = "Your Property Matches";
}

<div class="recommendation-page py-5">
    <div class="container py-3">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb small mb-2">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Recommendation" asp-action="Index" class="text-decoration-none text-muted">Smart Recommendation</a></li>
                        <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Your Matches</li>
                    </ol>
                </nav>
                <h1 class="h2 fw-bold mb-1">Your best verified matches</h1>
                <p class="text-muted mb-0">Ranked against your preferences for @Model.Preferences.Location.Trim().</p>
            </div>
            <a asp-controller="Recommendation" asp-action="Index" class="btn btn-outline-custom d-inline-flex align-items-center gap-2">
                <i class="bi bi-sliders"></i> Change Preferences
            </a>
        </div>

        @if (Model.Properties.Count == 0)
        {
            <div class="recommendation-empty py-5 px-4 text-center">
                <i class="bi bi-house-exclamation fs-1 text-muted"></i>
                <h2 class="h5 fw-bold mt-3">No verified properties found</h2>
                <p class="text-muted mb-3">There are no approved listings to compare right now.</p>
                <a asp-controller="Recommendation" asp-action="Index" class="btn btn-primary-custom">Adjust Preferences</a>
            </div>
        }
        else
        {
            <p class="small text-muted mb-3">@Model.Properties.Count verified properties ranked by match score.</p>

            @foreach (var property in Model.Properties)
            {
                <article class="recommendation-result mb-4">
                    <div class="row g-0">
                        <div class="col-md-4">
                            <img src="@property.ImageUrl" alt="@property.Title" class="recommendation-result-image" loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80';" />
                        </div>
                        <div class="col-md-8 p-3 p-lg-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        <span class="badge badge-verified"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>
                                        <span class="badge bg-primary-subtle text-primary border">@property.PropertyType</span>
                                        @if (property.TransactionStatus == PropLink.Domain.Enums.TransactionStatus.Sold)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border">Sold</span>
                                        }
                                        else if (property.TransactionStatus == PropLink.Domain.Enums.TransactionStatus.UnderProcessing)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border">Under processing</span>
                                        }
                                    </div>
                                    <h2 class="h5 fw-bold mb-1">
                                        <a asp-controller="Property" asp-action="Details" asp-route-id="@property.Id" class="text-dark text-decoration-none">@property.Title</a>
                                    </h2>
                                    <p class="small text-muted mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@property.Address, @property.City, @property.State</p>
                                    <div class="h5 fw-bold text-emerald mb-0">@property.FormattedPrice</div>
                                </div>
                                <div class="recommendation-score" aria-label="@property.MatchPercentage percent match">
                                    <span class="recommendation-score-value">@property.MatchPercentage%</span>
                                    <span class="small text-muted">Match</span>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="progress recommendation-progress" role="progressbar" aria-label="Property match score" aria-valuenow="@property.MatchPercentage" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar" style="width: @property.MatchPercentage%"></div>
                                </div>
                                <p class="small text-muted mt-2 mb-0">Score coverage: @property.DataCoveragePercentage% of weighted criteria had usable data.</p>
                            </div>

                            <div class="recommendation-specs d-flex flex-wrap gap-3 mt-3 py-3 border-top border-bottom small">
                                <span><i class="bi bi-door-open text-primary me-1"></i>@property.Bedrooms bedrooms</span>
                                <span><i class="bi bi-droplet text-primary me-1"></i>@property.Bathrooms bathrooms</span>
                                <span><i class="bi bi-aspect-ratio text-primary me-1"></i>@property.SquareFeet.ToString("N0") sq.ft.</span>
                                <span><i class="bi bi-car-front text-primary me-1"></i>@(property.ParkingAvailable == true ? "Parking available" : property.ParkingAvailable == false ? "No parking" : "Parking info unavailable")</span>
                            </div>

                            <details class="recommendation-breakdown mt-3">
                                <summary class="fw-bold">Why this property matches</summary>
                                <div class="row g-2 mt-2">
                                    @foreach (var detail in property.Details)
                                    {
                                        var isFullMatch = detail.IsAssessed && detail.PointsAwarded >= detail.Weight;
                                        var hasPartialMatch = detail.IsAssessed && detail.PointsAwarded > 0 && detail.PointsAwarded < detail.Weight;
                                        <div class="col-md-6">
                                            <div class="recommendation-detail d-flex gap-2 p-2 h-100">
                                                <i class="bi @(isFullMatch ? "bi-check-circle-fill text-success" : hasPartialMatch ? "bi-dash-circle-fill text-warning" : detail.IsAssessed ? "bi-x-circle-fill text-danger" : "bi-info-circle-fill text-muted") mt-1"></i>
                                                <div>
                                                    <div class="d-flex justify-content-between gap-2 small">
                                                        <strong>@detail.Name</strong>
                                                        <span class="text-muted text-nowrap">@(detail.IsAssessed ? detail.PointsAwarded.ToString("0.#") : "N/A") / @detail.Weight pts</span>
                                                    </div>
                                                    <p class="small text-muted mb-0">@detail.Explanation</p>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </details>

                            <div class="d-flex justify-content-end mt-3">
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@property.Id" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
                                    View Details <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </article>
            }
        }
    </div>
</div>

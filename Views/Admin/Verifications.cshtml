@model PropLink.Web.Models.AdminVerificationDashboardViewModel
@{
    ViewData["Title"] = "Administrator Verification Portal";
}

<div class="admin-verification-page py-5">
    <div class="container py-3">
        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle mb-2 px-3 py-1">
                    <i class="bi bi-shield-lock-fill me-1"></i> Administrator Compliance Queue
                </span>
                <h1 class="h2 fw-bold mb-1">Property Document <span class="gradient-text">Verification Audit</span></h1>
                <p class="text-muted mb-0">Review pending seller applications, examine title deeds & NID cards, and issue verification approvals.</p>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-house me-1"></i> Public Marketplace
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 p-4 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-check-circle-fill fs-2 text-success"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">Listing Approved!</h5>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ToastMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> @TempData["ToastMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Metrics Overview -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-warning border-5">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Pending Audit Queue</span>
                            <h2 class="h3 fw-bold mb-0 text-warning mt-1">@Model.TotalPendingCount Submissions</h2>
                        </div>
                        <div class="icon-bubble bg-warning-subtle text-warning fs-3 p-3 rounded-circle">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-success border-5">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Approved & Publicly Live</span>
                            <h2 class="h3 fw-bold mb-0 text-success mt-1">@Model.TotalApprovedCount Properties</h2>
                        </div>
                        <div class="icon-bubble bg-success-subtle text-success fs-3 p-3 rounded-circle">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-danger border-5">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Rejected Submissions</span>
                            <h2 class="h3 fw-bold mb-0 text-danger mt-1">@Model.TotalRejectedCount Listings</h2>
                        </div>
                        <div class="icon-bubble bg-danger-subtle text-danger fs-3 p-3 rounded-circle">
                            <i class="bi bi-x-octagon-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Submissions Queue -->
        <h4 class="h5 fw-bold mb-3 d-flex align-items-center gap-2">
            <span>Pending Review Submissions</span>
            <span class="badge bg-warning text-dark rounded-pill">@Model.PendingProperties.Count</span>
        </h4>

        @if (Model.PendingProperties.Any())
        {
            <div class="d-flex flex-column gap-4 mb-5">
                @foreach (var item in Model.PendingProperties)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white position-relative">
                        <div class="row g-4">
                            <!-- Column 1: Property Details & Photos -->
                            <div class="col-lg-7">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-warning text-dark me-2">Pending Audit</span>
                                        <span class="badge bg-light text-dark border">@item.PropertyType</span>
                                        <span class="text-muted small ms-2"><i class="bi bi-clock me-1"></i>Submitted @item.SubmittedAt.ToString("g")</span>
                                    </div>
                                    <h4 class="fw-bold text-primary mb-0">@item.Price.ToString("C0")</h4>
                                </div>

                                <h3 class="h5 fw-bold mb-2 text-dark">@item.Title</h3>
                                <p class="text-muted small mb-3">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.Address, @item.City, @item.State
                                </p>

                                <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded-3 small text-muted mb-3 border">
                                    <span><i class="bi bi-bounding-box me-1 text-primary"></i><strong>@item.SquareFeet.ToString("N0")</strong> sq ft</span>
                                    <span><i class="bi bi-door-open me-1 text-primary"></i><strong>@item.Bedrooms</strong> Beds</span>
                                    <span><i class="bi bi-water me-1 text-primary"></i><strong>@item.Bathrooms</strong> Baths</span>
                                </div>

                                <!-- Gallery Photos Preview -->
                                @if (item.ImageUrls.Any())
                                {
                                    <label class="form-label small fw-bold text-muted mb-2">Submitted Photos:</label>
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @foreach (var img in item.ImageUrls)
                                        {
                                            <a href="@img" target="_blank" title="View full image">
                                                <img src="@img" class="rounded-3 border shadow-sm" style="width: 90px; height: 65px; object-fit: cover;" alt="Photo" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80';" />
                                            </a>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Column 2: Seller Info & Confidential Documents -->
                            <div class="col-lg-5 border-start-lg ps-lg-4">
                                <!-- Seller Identity Box -->
                                <div class="p-3 bg-light rounded-4 border mb-3">
                                    <h6 class="fw-bold mb-2 d-flex align-items-center gap-2">
                                        <i class="bi bi-person-check text-primary"></i>
                                        <span>Seller Identity</span>
                                    </h6>
                                    <div class="small text-muted mb-1"><strong>Name:</strong> @item.SellerName</div>
                                    <div class="small text-muted mb-1"><strong>Email:</strong> @item.SellerEmail</div>
                                    <div class="small text-muted mb-0"><strong>Phone:</strong> @item.SellerPhone</div>
                                </div>

                                <!-- Confidential Documents Box -->
                                <div class="p-3 rounded-4 border mb-4" style="background-color: #fcfcfd;">
                                    <h6 class="fw-bold mb-2 text-danger d-flex align-items-center justify-content-between">
                                        <span><i class="bi bi-file-earmark-lock text-danger me-1"></i> Verification Files</span>
                                        <span class="badge bg-danger-subtle text-danger" style="font-size: 0.7rem;">Confidential</span>
                                    </h6>

                                    @if (item.Documents.Any())
                                    {
                                        <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                            @foreach (var doc in item.Documents)
                                            {
                                                <li class="d-flex flex-wrap justify-content-between align-items-center p-2 rounded-3 bg-white border gap-2">
                                                    <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1" style="min-width: 140px;">
                                                        <i class="bi @(doc.DocumentType == "NID" ? "bi-person-badge text-primary" : "bi-file-earmark-text text-success") fs-4"></i>
                                                        <div class="text-truncate">
                                                            <strong class="d-block small text-dark">@doc.DocumentType</strong>
                                                            <span class="small text-muted text-truncate d-block" style="max-width: 150px;" title="@doc.FileName">@doc.FileName</span>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <!-- PREVIEW BUTTON (Opens Modal Viewer) -->
                                                        <button type="button" class="btn btn-sm btn-primary-custom px-2 py-1 d-flex align-items-center gap-1"
                                                                onclick="openDocumentViewer('@doc.SecureViewUrl', '@doc.SecureDownloadUrl', '@doc.DocumentType: @doc.FileName', '@doc.FileName')">
                                                            <i class="bi bi-eye"></i> Preview
                                                        </button>
                                                        <!-- DOWNLOAD BUTTON -->
                                                        <a href="@doc.SecureDownloadUrl" class="btn btn-sm btn-outline-secondary px-2 py-1 d-flex align-items-center gap-1" title="Download directly to your device">
                                                            <i class="bi bi-download"></i> Download
                                                        </a>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="small text-danger mb-0">No verification documents attached.</p>
                                    }
                                </div>

                                <!-- Approval & Rejection Action Buttons -->
                                <div class="d-flex gap-2">
                                    <!-- APPROVE FORM -->
                                    <form asp-controller="Admin" asp-action="Approve" asp-route-id="@item.Id" method="post" class="flex-grow-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-1" onclick="return confirm('Confirm approval for listing: @item.Title?');">
                                            <i class="bi bi-check-circle-fill"></i> APPROVE
                                        </button>
                                    </form>

                                    <!-- REJECT BUTTON (Triggers Modal) -->
                                    <button type="button" class="btn btn-outline-danger flex-grow-1 py-2 fw-bold d-flex align-items-center justify-content-center gap-1" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                        <i class="bi bi-x-circle-fill"></i> REJECT
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reject Modal for this property -->
                    <div class="modal fade" id="rejectModal-@item.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@item.Id" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold text-danger" id="rejectModalLabel-@item.Id">
                                        <i class="bi bi-exclamation-octagon-fill me-2"></i>Reject Listing Application
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form asp-controller="Admin" asp-action="Reject" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="PropertyId" value="@item.Id" />
                                    <div class="modal-body py-3">
                                        <p class="small text-muted mb-3">
                                            Provide a specific reason for rejecting <strong>@item.Title</strong>. The seller (@item.SellerName) will see this remark in their profile dashboard and can revise the listing for resubmission.
                                        </p>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Rejection Reason <span class="text-danger">*</span></label>
                                            <textarea name="RejectionReason" class="form-control form-control-custom" rows="4" placeholder="e.g. The submitted Title Deed was blurry/illegible. Please upload a clear scanned copy of page 2 with official seal..." required></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                                            Confirm Rejection
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 bg-white">
                <div class="text-success fs-1 mb-2">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h4 class="fw-bold">Audit Queue is Clear</h4>
                <p class="text-muted small max-w-500 mx-auto mb-0">
                    There are currently no pending property applications requiring compliance review. All submitted listings have been processed.
                </p>
            </div>
        }
    </div>
</div>

<!-- ADMIN DOCUMENT PREVIEW MODAL (Full Screen / Responsive Viewer) -->
<div class="modal fade" id="docViewerModal" tabindex="-1" aria-labelledby="docViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 90vw;">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <div class="d-flex align-items-center gap-2 overflow-hidden">
                    <i class="bi bi-file-earmark-lock-fill text-warning fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="docViewerModalLabel">Document Verification Vault</h5>
                        <span class="small text-light opacity-75" id="docViewerFileName">Confidential Property Document</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a id="docViewerDownloadBtn" href="#" class="btn btn-sm btn-success d-flex align-items-center gap-1 fw-semibold">
                        <i class="bi bi-download"></i> Download File
                    </a>
                    <a id="docViewerNewTabBtn" href="#" target="_blank" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-up-right"></i> Open in New Tab
                    </a>
                    <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-0 bg-light position-relative" style="height: 75vh; min-height: 500px;">
                <div id="docViewerLoading" class="position-absolute top-50 start-50 translate-middle text-center">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <p class="small text-muted mb-0">Loading confidential document from Supabase vault...</p>
                </div>
                <iframe id="docViewerFrame" src="" class="w-100 h-100 border-0" style="display: block;" onload="document.getElementById('docViewerLoading').style.display='none';"></iframe>
            </div>
            <div class="modal-footer bg-white border-top py-2 px-4 d-flex justify-content-between">
                <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i> PropLink Legal Compliance Security Active</span>
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close Viewer</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openDocumentViewer(viewUrl, downloadUrl, title, fileName) {
        document.getElementById('docViewerModalLabel').innerText = title;
        document.getElementById('docViewerFileName').innerText = fileName || 'Legal Verification Document';
        document.getElementById('docViewerDownloadBtn').href = downloadUrl;
        document.getElementById('docViewerNewTabBtn').href = viewUrl;
        
        var loading = document.getElementById('docViewerLoading');
        if (loading) loading.style.display = 'block';
        
        var iframe = document.getElementById('docViewerFrame');
        iframe.src = viewUrl;
        
        var modal = new bootstrap.Modal(document.getElementById('docViewerModal'));
        modal.show();
    }
</script>

@model PropLink.Web.Models.AdminVerificationDashboardViewModel
@{
    ViewData["Title"] = "Administrator Verification Portal";
}

<div class="admin-verification-page py-5">
    <div class="container py-3">
        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle mb-2 px-3 py-1">
                    <i class="bi bi-shield-lock-fill me-1"></i> Administrator Compliance Queue
                </span>
                <h1 class="h2 fw-bold mb-1">Property Document <span class="gradient-text">Verification Audit</span></h1>
                <p class="text-muted mb-0">Review pending seller applications, examine title deeds & NID cards, and issue verification approvals.</p>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-house me-1"></i> Public Marketplace
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 p-4 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-check-circle-fill fs-2 text-success"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">Listing Approved!</h5>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ToastMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> @TempData["ToastMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Secondary Queue Tabs -->
        <div class="mb-4">
            <ul class="nav nav-pills custom-segmented-pills gap-2" id="adminQueueTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <a href="@Url.Action("Verifications", "Admin", new { tab = "properties" })" class="nav-link rounded-pill px-4 py-2 fw-bold d-flex align-items-center gap-2 @(Model.ActiveTab == "properties" ? "active" : "")">
                        <i class="bi bi-file-earmark-check"></i>
                        <span>Property Deed Verifications</span>
                        <span class="badge rounded-pill bg-white text-dark ms-1">@Model.TotalPendingCount</span>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="@Url.Action("Verifications", "Admin", new { tab = "bidding" })" class="nav-link rounded-pill px-4 py-2 fw-bold d-flex align-items-center gap-2 @(Model.ActiveTab == "bidding" ? "active text-white bg-danger" : "")">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>Bidding & Auction Requests</span>
                        <span class="badge rounded-pill bg-white text-dark ms-1">@Model.TotalBiddingPendingCount</span>
                    </a>
                </li>
            </ul>
        </div>

        @if (Model.ActiveTab == "properties")
        {
            <!-- Metrics Overview: Properties -->
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-warning border-5">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-semibold">Pending Deed Audits</span>
                                <h2 class="h3 fw-bold mb-0 text-warning mt-1">@Model.TotalPendingCount Submissions</h2>
                            </div>
                            <div class="icon-bubble bg-warning-subtle text-warning fs-3 p-3 rounded-circle">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-success border-5">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-semibold">Approved & Publicly Live</span>
                                <h2 class="h3 fw-bold mb-0 text-success mt-1">@Model.TotalApprovedCount Properties</h2>
                            </div>
                            <div class="icon-bubble bg-success-subtle text-success fs-3 p-3 rounded-circle">
                                <i class="bi bi-patch-check-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-danger border-5">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-semibold">Rejected Submissions</span>
                                <h2 class="h3 fw-bold mb-0 text-danger mt-1">@Model.TotalRejectedCount Listings</h2>
                            </div>
                            <div class="icon-bubble bg-danger-subtle text-danger fs-3 p-3 rounded-circle">
                                <i class="bi bi-x-octagon-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pending Submissions Queue -->
            <h4 class="h5 fw-bold mb-3 d-flex align-items-center gap-2">
                <span>Pending Property Deed Audits</span>
                <span class="badge bg-warning text-dark rounded-pill">@Model.PendingProperties.Count</span>
            </h4>

            @if (Model.PendingProperties.Any())
            {
                <div class="d-flex flex-column gap-4 mb-5">
                    @foreach (var item in Model.PendingProperties)
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white position-relative">
                            <div class="row g-4">
                                <!-- Column 1: Property Details & Photos -->
                                <div class="col-lg-7">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="badge bg-warning text-dark me-2">Pending Audit</span>
                                            <span class="badge bg-light text-dark border">@item.PropertyType</span>
                                            <span class="text-muted small ms-2"><i class="bi bi-clock me-1"></i>Submitted @item.SubmittedAt.ToString("g")</span>
                                        </div>
                                        <h4 class="fw-bold text-primary mb-0">@item.Price.ToString("C0")</h4>
                                    </div>

                                    <h3 class="h5 fw-bold mb-2 text-dark">@item.Title</h3>
                                    <p class="text-muted small mb-3">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.Address, @item.City, @item.State
                                    </p>

                                    <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded-3 small text-muted mb-3 border">
                                        <span><i class="bi bi-bounding-box me-1 text-primary"></i><strong>@item.SquareFeet.ToString("N0")</strong> sq ft</span>
                                        <span><i class="bi bi-door-open me-1 text-primary"></i><strong>@item.Bedrooms</strong> Beds</span>
                                        <span><i class="bi bi-water me-1 text-primary"></i><strong>@item.Bathrooms</strong> Baths</span>
                                    </div>

                                    <!-- Gallery Preview Strip -->
                                    @if (item.ImageUrls.Any())
                                    {
                                        <div class="mb-3">
                                            <span class="small fw-semibold text-muted d-block mb-2">Gallery Photos (@item.ImageUrls.Count):</span>
                                            <div class="d-flex gap-2 overflow-auto pb-2">
                                                @foreach (var img in item.ImageUrls)
                                                {
                                                    <a href="@img" target="_blank" class="d-inline-block">
                                                        <img src="@img" class="rounded-3 border object-fit-cover shadow-sm" style="width: 100px; height: 75px;" alt="Property photo" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80';" />
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Seller Information -->
                                    <div class="p-3 rounded-3 border bg-light small">
                                        <div class="fw-bold text-dark mb-1"><i class="bi bi-person-badge text-primary me-1"></i>Seller Identity:</div>
                                        <div class="d-flex flex-wrap gap-3 text-muted">
                                            <span><strong>Name:</strong> @item.SellerName</span>
                                            <span><strong>Email:</strong> @item.SellerEmail</span>
                                            <span><strong>Phone:</strong> @item.SellerPhone</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Column 2: Legal Documents & Approval Actions -->
                                <div class="col-lg-5 d-flex flex-column justify-content-between border-start-lg ps-lg-4">
                                    <div>
                                        <h5 class="h6 fw-bold mb-3 d-flex align-items-center gap-2">
                                            <i class="bi bi-file-earmark-lock-fill text-danger"></i>
                                            <span>Confidential Legal Documents</span>
                                        </h5>

                                        @if (item.Documents.Any())
                                        {
                                            <div class="list-group list-group-flush mb-4 border rounded-3 overflow-hidden">
                                                @foreach (var doc in item.Documents)
                                                {
                                                    <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                                        <div class="overflow-hidden me-2">
                                                            <div class="fw-semibold text-dark text-truncate">
                                                                <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>
                                                                @doc.DocumentType
                                                            </div>
                                                            <div class="small text-muted text-truncate">@doc.FileName</div>
                                                        </div>
                                                        <div class="d-flex gap-1 flex-shrink-0">
                                                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="openDocumentViewer('@doc.SecureViewUrl', '@doc.SecureDownloadUrl', '@doc.DocumentType: @item.Title', '@doc.FileName')">
                                                                <i class="bi bi-eye"></i> View
                                                            </button>
                                                            <a href="@doc.SecureDownloadUrl" class="btn btn-sm btn-outline-secondary" download>
                                                                <i class="bi bi-download"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning small mb-4">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> No legal documents uploaded. Verification cannot proceed without valid deed records.
                                            </div>
                                        }
                                    </div>

                                    <!-- Compliance Decision Controls -->
                                    <div class="pt-3 border-top">
                                        <div class="d-flex gap-2">
                                            <!-- Approve Form -->
                                            <form asp-controller="Admin" asp-action="Approve" asp-route-id="@item.Id" method="post" class="flex-fill" onsubmit="return confirm('Confirm legal title approval for &quot;@item.Title&quot;? This will publish the listing publicly.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-1 rounded-pill">
                                                    <i class="bi bi-check-circle-fill"></i> Approve & Publish
                                                </button>
                                            </form>

                                            <!-- Reject Modal Trigger -->
                                            <button type="button" class="btn btn-outline-danger flex-fill py-2 fw-bold d-flex align-items-center justify-content-center gap-1 rounded-pill" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                                <i class="bi bi-x-circle-fill"></i> Reject Submission
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reject Modal for Property -->
                        <div class="modal fade" id="rejectModal-@item.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@item.Id" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 pb-0">
                                        <h5 class="modal-title fw-bold text-danger" id="rejectModalLabel-@item.Id">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Reject Property Application
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-controller="Admin" asp-action="Reject" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="PropertyId" value="@item.Id" />
                                        <div class="modal-body py-3">
                                            <p class="small text-muted mb-3">
                                                Please specify why <strong>@item.Title</strong> was rejected. This explanation will be displayed to the seller so they can correct documents and resubmit.
                                            </p>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Rejection Reason & Required Fixes</label>
                                                <textarea name="RejectionReason" class="form-control form-control-custom" rows="4" placeholder="e.g. The uploaded deed scan is unreadable. Please upload a clear municipal deed with valid seal..." required minlength="5"></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                                                <i class="bi bi-x-octagon me-1"></i> Confirm Rejection
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 bg-white">
                    <div class="text-success fs-1 mb-2">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="fw-bold">Audit Queue is Clear</h4>
                    <p class="text-muted small max-w-500 mx-auto mb-0">
                        There are currently no pending property applications requiring compliance review. All submitted listings have been processed.
                    </p>
                </div>
            }
        }
        else
        {
            <!-- ========================================== -->
            <!-- BIDDING & AUCTION REQUESTS QUEUE -->
            <!-- ========================================== -->
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-danger border-5">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-semibold">Pending Bidding Requests</span>
                                <h2 class="h3 fw-bold mb-0 text-danger mt-1">@Model.TotalBiddingPendingCount Requests</h2>
                            </div>
                            <div class="icon-bubble bg-danger-subtle text-danger fs-3 p-3 rounded-circle">
                                <i class="bi bi-lightning-charge-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-success border-5">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-semibold">Approved Live Auctions</span>
                                <h2 class="h3 fw-bold mb-0 text-success mt-1">@Model.TotalBiddingApprovedCount Launched</h2>
                            </div>
                            <div class="icon-bubble bg-success-subtle text-success fs-3 p-3 rounded-circle">
                                <i class="bi bi-patch-check-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-secondary border-5">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-semibold">Declined Bidding Requests</span>
                                <h2 class="h3 fw-bold mb-0 text-secondary mt-1">@Model.TotalBiddingRejectedCount Declined</h2>
                            </div>
                            <div class="icon-bubble bg-secondary-subtle text-secondary fs-3 p-3 rounded-circle">
                                <i class="bi bi-x-circle-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <h4 class="h5 fw-bold mb-3 d-flex align-items-center gap-2">
                <span>Pending Bidding & Auction Permission Requests</span>
                <span class="badge bg-danger text-white rounded-pill">@Model.BiddingRequests.Count</span>
            </h4>

            @if (Model.BiddingRequests.Any())
            {
                <div class="d-flex flex-column gap-4 mb-5">
                    @foreach (var req in Model.BiddingRequests)
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white position-relative">
                            <div class="row g-4 align-items-center">
                                <div class="col-md-3">
                                    <img src="@req.PropertyImageUrl" class="rounded-4 w-100 object-fit-cover shadow-sm" style="height: 140px;" alt="@req.PropertyTitle" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80';" />
                                </div>

                                <div class="col-md-5">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-lightning-charge me-1"></i> Bidding Request
                                        </span>
                                        <span class="small text-muted"><i class="bi bi-clock me-1"></i>@req.RequestedAt.ToString("g")</span>
                                    </div>

                                    <h5 class="fw-bold mb-1">
                                        <a asp-controller="Property" asp-action="Details" asp-route-id="@req.PropertyId" target="_blank" class="text-dark text-decoration-none">
                                            @req.PropertyTitle
                                        </a>
                                    </h5>
                                    <p class="small text-muted mb-2"><i class="bi bi-geo-alt me-1 text-danger"></i>@req.Location</p>

                                    <div class="small text-muted">
                                        <span><strong>Seller:</strong> @req.SellerName (@req.SellerEmail)</span>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-4 mb-3 small">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Floor Start Price:</span>
                                            <strong class="text-danger">@req.FormattedStartPrice</strong>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Min Increment:</span>
                                            <strong>@req.FormattedMinIncrement</strong>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted">Fixed Duration:</span>
                                            <strong>@req.DurationHours Hours</strong>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <!-- Approve Bidding Request -->
                                        <form asp-controller="Admin" asp-action="ApproveBiddingRequest" asp-route-id="@req.Id" method="post" class="flex-fill" onsubmit="return confirm('Approve bidding request and launch a @req.DurationHours-hour fixed auction for &quot;@req.PropertyTitle&quot;?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger w-100 rounded-pill btn-sm py-2 fw-bold d-flex align-items-center justify-content-center gap-1">
                                                <i class="bi bi-check-circle-fill"></i> Approve & Launch
                                            </button>
                                        </form>

                                        <!-- Reject Bidding Request Modal Trigger -->
                                        <button type="button" class="btn btn-outline-secondary rounded-pill btn-sm py-2 fw-bold px-3" data-bs-toggle="modal" data-bs-target="#rejectBiddingModal-@req.Id">
                                            Decline
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reject Bidding Request Modal -->
                        <div class="modal fade" id="rejectBiddingModal-@req.Id" tabindex="-1" aria-labelledby="rejectBiddingModalLabel-@req.Id" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 pb-0">
                                        <h5 class="modal-title fw-bold text-danger" id="rejectBiddingModalLabel-@req.Id">
                                            <i class="bi bi-x-circle me-2"></i>Decline Bidding Request
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-controller="Admin" asp-action="RejectBiddingRequest" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="RequestId" value="@req.Id" />
                                        <div class="modal-body py-3">
                                            <p class="small text-muted mb-3">
                                                Specify why auction permission was declined for <strong>@req.PropertyTitle</strong>.
                                            </p>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Reason for Seller</label>
                                                <textarea name="AdminNote" class="form-control form-control-custom" rows="3" placeholder="e.g. Floor price is outside normal market parameters or property requires additional verification..." required minlength="5"></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                                                <i class="bi bi-x-circle me-1"></i> Decline Request
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 bg-white">
                    <div class="text-danger fs-1 mb-2">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <h4 class="fw-bold">No Pending Bidding Requests</h4>
                    <p class="text-muted small max-w-500 mx-auto mb-0">
                        There are currently no pending seller requests to activate live competitive bidding.
                    </p>
                </div>
            }
        }
    </div>
</div>

<!-- ADMIN DOCUMENT PREVIEW MODAL (Full Screen / Responsive Viewer) -->
<div class="modal fade" id="docViewerModal" tabindex="-1" aria-labelledby="docViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 90vw;">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <div class="d-flex align-items-center gap-2 overflow-hidden">
                    <i class="bi bi-file-earmark-lock-fill text-warning fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="docViewerModalLabel">Document Verification Vault</h5>
                        <span class="small text-light opacity-75" id="docViewerFileName">Confidential Property Document</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a id="docViewerDownloadBtn" href="#" class="btn btn-sm btn-success d-flex align-items-center gap-1 fw-semibold">
                        <i class="bi bi-download"></i> Download File
                    </a>
                    <a id="docViewerNewTabBtn" href="#" target="_blank" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-up-right"></i> Open in New Tab
                    </a>
                    <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-0 bg-light position-relative" style="height: 75vh; min-height: 500px;">
                <div id="docViewerLoading" class="position-absolute top-50 start-50 translate-middle text-center">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <p class="small text-muted mb-0">Loading confidential document from Supabase vault...</p>
                </div>
                <iframe id="docViewerFrame" src="" class="w-100 h-100 border-0" style="display: block;" onload="document.getElementById('docViewerLoading').style.display='none';"></iframe>
            </div>
            <div class="modal-footer bg-white border-top py-2 px-4 d-flex justify-content-between">
                <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i> PropLink Legal Compliance Security Active</span>
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close Viewer</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openDocumentViewer(viewUrl, downloadUrl, title, fileName) {
        document.getElementById('docViewerModalLabel').innerText = title;
        document.getElementById('docViewerFileName').innerText = fileName || 'Legal Verification Document';
        document.getElementById('docViewerDownloadBtn').href = downloadUrl;
        document.getElementById('docViewerNewTabBtn').href = viewUrl;
        
        var loading = document.getElementById('docViewerLoading');
        if (loading) loading.style.display = 'block';
        
        var iframe = document.getElementById('docViewerFrame');
        iframe.src = viewUrl;
        
        var modal = new bootstrap.Modal(document.getElementById('docViewerModal'));
        modal.show();
    }
</script>

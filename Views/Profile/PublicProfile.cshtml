@model PropLink.Web.Models.PublicUserProfileViewModel
@{
    ViewData["Title"] = $"{Model.FullName} - Member Profile";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Property" asp-action="Index">Catalog</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.IsBanned)
    {
        <!-- Prominent Banned Notice Banner -->
        <div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 mb-4">
            <div class="d-flex align-items-start gap-3">
                <div class="p-3 bg-danger text-white rounded-circle">
                    <i class="bi bi-slash-circle-fill fs-3"></i>
                </div>
                <div>
                    <h5 class="alert-heading fw-bold mb-1 text-danger">ACCOUNT TERMINATED & BANNED</h5>
                    <p class="mb-1">This user was banned on @(Model.BannedAt?.ToString("MMM dd, yyyy") ?? "recently") by PropLink platform administration for violating anti-fraud, compliance, or title deed integrity rules.</p>
                    <div class="small fw-semibold text-danger">Reason: @(Model.BanReason ?? "Fraudulent activity detected.")</div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4 mb-5">
        <!-- User Profile Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white sticky-top" style="top: 100px;">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <div class="seller-avatar @(Model.IsBanned ? "bg-danger" : "bg-emerald") text-white fs-1 fw-bold shadow" style="width: 90px; height: 90px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1))
                    </div>
                    @if (Model.IsBanned)
                    {
                        <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-danger border border-white p-2" title="Banned User">
                            <i class="bi bi-x-octagon-fill"></i>
                        </span>
                    }
                    else
                    {
                        <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success border border-white p-2" title="Verified Member">
                            <i class="bi bi-shield-fill-check"></i>
                        </span>
                    }
                </div>

                <h4 class="fw-bold mb-1 text-heading">@Model.FullName</h4>
                <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                    @if (Model.IsBanned)
                    {
                        <span class="badge bg-danger">Permanently Banned</span>
                    }
                    else
                    {
                        <span class="badge bg-emerald-light text-emerald"><i class="bi bi-patch-check-fill me-1"></i>Verified Member</span>
                    }
                    <span class="badge bg-light text-muted border">@Model.Role</span>
                </div>

                <div class="border-top border-bottom py-3 my-3 text-start small text-muted">
                    <div class="d-flex justify-content-between mb-2">
                        <span><i class="bi bi-calendar3 text-emerald me-2"></i>Member Since:</span>
                        <span class="fw-semibold text-dark">@Model.MemberSince.ToString("MMMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span><i class="bi bi-building text-emerald me-2"></i>Verified Listings:</span>
                        <span class="fw-semibold text-dark">@Model.TotalVerifiedProperties</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span><i class="bi bi-envelope text-emerald me-2"></i>Email Address:</span>
                        <span class="fw-semibold text-dark text-truncate ms-2">@Model.Email</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <div class="d-flex justify-content-between">
                            <span><i class="bi bi-telephone text-emerald me-2"></i>Phone:</span>
                            <span class="fw-semibold text-dark">@Model.PhoneNumber</span>
                        </div>
                    }
                </div>

                <!-- Report Fraud Button -->
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-danger btn-sm py-2 rounded-3 d-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#userProfileReportModal">
                        <i class="bi bi-flag-fill text-danger"></i>
                        <span class="fw-bold">Report Fraud to Admin</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- User Listed Properties -->
        <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h4 class="fw-bold mb-1 text-heading">Verified Listings by @Model.FullName</h4>
                    <p class="text-muted small mb-0">Properties audited and verified for legitimate legal title records</p>
                </div>
                <span class="badge bg-emerald-light text-emerald px-3 py-2 rounded-pill fw-bold">
                    @Model.ActiveProperties.Count Properties
                </span>
            </div>

            @if (Model.ActiveProperties.Any())
            {
                <div class="row g-4">
                    @foreach (var property in Model.ActiveProperties)
                    {
                        <div class="col-md-6">
                            <partial name="_PropertyCard" model="property" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <div class="mb-3">
                        <i class="bi bi-building-slash text-muted fs-1"></i>
                    </div>
                    <h5 class="fw-bold mb-1">No Active Properties</h5>
                    <p class="text-muted small mb-0">This member currently has no active verified properties listed on PropLink.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- FRAUD REPORT MODAL -->
<!-- ========================================== -->
<div class="modal fade" id="userProfileReportModal" tabindex="-1" aria-labelledby="userProfileReportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-white bg-opacity-25 rounded-3">
                        <i class="bi bi-shield-exclamation fs-3 text-white"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="userProfileReportModalLabel">Report @Model.FullName for Fraud to Admin</h5>
                        <p class="small mb-0 text-white-50">Upload proofs and incident details. Direct ban without warning if found guilty.</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Profile" asp-action="SubmitReport" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReportedUserId" value="@Model.UserId" />
                <input type="hidden" name="ReportedUserName" value="@Model.FullName" />
                <input type="hidden" name="ReportedUserEmail" value="@Model.Email" />
                <input type="hidden" name="ReturnUrl" value="@Context.Request.Path" />

                <div class="modal-body p-4">
                    <div class="p-3 rounded-3 bg-light border border-danger-subtle mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="seller-avatar bg-danger text-white fw-bold" style="width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1))
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Suspect: @Model.FullName (@Model.Email)</div>
                                <div class="small text-muted">Member Since: @Model.MemberSince.ToString("MMM yyyy") | ID: @Model.UserId.ToString()[..8]...</div>
                            </div>
                        </div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Direct Fraud Report
                        </span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">
                                Fraud Category <span class="text-danger">*</span>
                            </label>
                            <select name="Category" class="form-select form-control-custom" required>
                                <option value="Fake Title Deed / Document Forgery">Fake Title Deed / Document Forgery</option>
                                <option value="Off-Platform Cash / Wire Payment Scam">Off-Platform Cash / Wire Payment Scam</option>
                                <option value="Identity Theft / False Representation">Identity Theft / False Representation</option>
                                <option value="Phishing / Malicious Communication">Phishing / Malicious Communication</option>
                                <option value="Misleading Specifications / Property Does Not Exist">Misleading Specifications / Property Does Not Exist</option>
                                <option value="Abuse / Harassment / Extortion">Abuse / Harassment / Extortion</option>
                                <option value="Other Suspicious Activity">Other Suspicious Activity</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">
                                Detailed Incident Description <span class="text-danger">*</span>
                            </label>
                            <textarea name="Description" class="form-control form-control-custom" rows="4" placeholder="Detail the scam, fraudulent requests, forged documents, or fraudulent actions observed..." required minlength="15"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">
                                <i class="bi bi-paperclip me-1 text-primary"></i> Upload Evidence Proof (PDF, Screenshot, Chat Log, Receipt)
                            </label>
                            <input type="file" name="ProofFile" class="form-control form-control-custom" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx" />
                            <div class="form-text small text-muted">Attach concrete proof supporting the allegation (Max 25MB).</div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 rounded-3 bg-warning-subtle border border-warning-subtle text-warning-emphasis small">
                                <i class="bi bi-shield-fill-exclamation me-1"></i> <strong>Admin Review & Direct Ban Notice:</strong> Platform admins review incoming reports with top priority. If verified guilty of fraud, the offender will receive a direct and permanent ban.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top bg-light p-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-flag-fill"></i> Submit Report to Admin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

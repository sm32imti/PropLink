@model PropLink.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile & Activity Dashboard";
}

<div class="profile-dashboard-page py-5">
    <div class="container py-3">
        <!-- Submission / Toast Feedback -->
        @if (TempData["SubmissionSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 p-4 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-clock-history fs-2 text-success"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">Property Submission Received!</h5>
                        <p class="mb-0">@TempData["SubmissionSuccess"]</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ToastMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show rounded-4 p-3 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["ToastMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- User Profile Header Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
            <div class="row align-items-center g-4">
                <div class="col-auto">
                    <div class="seller-avatar bg-primary text-white fs-1 fw-bold rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px;">
                        @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1))
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h2 class="h3 fw-bold mb-0">@Model.FullName</h2>
                        <span class="badge @(Model.Role == "Admin" ? "bg-danger" : "bg-primary-subtle text-primary border border-primary-subtle")">
                            @Model.Role Account
                        </span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-shield-check me-1"></i> Authenticated User
                        </span>
                    </div>
                    <div class="text-muted small d-flex flex-wrap gap-3">
                        <span><i class="bi bi-envelope me-1 text-primary"></i>@Model.Email</span>
                        <span><i class="bi bi-telephone me-1 text-primary"></i>@Model.PhoneNumber</span>
                        <span><i class="bi bi-calendar3 me-1 text-primary"></i>Member since @Model.MemberSince.ToString("MMMM yyyy")</span>
                    </div>
                </div>
                <div class="col-12 col-md-auto">
                    <a asp-controller="Property" asp-action="Sell" class="btn btn-primary-custom d-flex align-items-center gap-2">
                        <i class="bi bi-plus-circle"></i>
                        <span>Sell a Property</span>
                    </a>
                </div>
            </div>

            <!-- Stats Overview Bar -->
            <div class="row g-3 mt-4 pt-3 border-top text-center">
                <div class="col-md-2 col-4">
                    <span class="h4 fw-bold text-dark d-block mb-0">@Model.TotalListedProperties</span>
                    <span class="small text-muted">Total Listed</span>
                </div>
                <div class="col-md-2 col-4">
                    <span class="h4 fw-bold text-success d-block mb-0">@Model.VerifiedListingsCount</span>
                    <span class="small text-muted">Approved & Live</span>
                </div>
                <div class="col-md-2 col-4">
                    <span class="h4 fw-bold text-warning d-block mb-0">@Model.PendingListingsCount</span>
                    <span class="small text-muted">Under Review</span>
                </div>
                <div class="col-md-2 col-4">
                    <span class="h4 fw-bold text-danger d-block mb-0">@Model.RejectedListingsCount</span>
                    <span class="small text-muted">Action Needed</span>
                </div>
                <div class="col-md-4 col-8 text-md-end">
                    <span class="h4 fw-bold text-primary d-block mb-0">@Model.TotalPurchasesCount</span>
                    <span class="small text-muted">Purchases & Agreements</span>
                </div>
            </div>
        </div>

        <!-- Dashboard Tabs: Selling History vs. Buying History -->
        <ul class="nav nav-pills custom-nav-pills mb-4 gap-2" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill px-4 py-2 fw-semibold" id="selling-tab" data-bs-toggle="pill" data-bs-target="#sellingHistory" type="button" role="tab" aria-controls="sellingHistory" aria-selected="true">
                    <i class="bi bi-building me-2"></i> Selling & Listing History (@Model.SellingHistory.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 py-2 fw-semibold" id="buying-tab" data-bs-toggle="pill" data-bs-target="#buyingHistory" type="button" role="tab" aria-controls="buyingHistory" aria-selected="false">
                    <i class="bi bi-bag-check me-2"></i> Buying History & Agreements (@Model.BuyingHistory.Count)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="profileTabsContent">
            <!-- TAB 1: SELLING / LISTING HISTORY -->
            <div class="tab-pane fade show active" id="sellingHistory" role="tabpanel" aria-labelledby="selling-tab">
                @if (Model.SellingHistory.Any())
                {
                    <div class="row g-4">
                        @foreach (var item in Model.SellingHistory)
                        {
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                                    <div class="row g-0 h-100">
                                        <div class="col-sm-5 position-relative">
                                            <img src="@item.MainImageUrl" class="img-fluid h-100 w-100" style="object-fit: cover; min-height: 180px;" alt="@item.Title" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80';" />
                                            <span class="badge position-absolute top-0 start-0 m-2 @(item.VerificationStatus == PropLink.Domain.Enums.VerificationStatus.Approved ? "bg-success" : (item.VerificationStatus == PropLink.Domain.Enums.VerificationStatus.Pending ? "bg-warning text-dark" : "bg-danger"))">
                                                <i class="bi @(item.VerificationStatus == PropLink.Domain.Enums.VerificationStatus.Approved ? "bi-patch-check-fill" : "bi-clock-history") me-1"></i>
                                                @item.VerificationStatus
                                            </span>
                                        </div>
                                        <div class="col-sm-7 p-3 d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-start mb-1">
                                                    <span class="badge bg-light text-dark border">@item.PropertyType</span>
                                                    <span class="badge bg-secondary-subtle text-secondary small">Tx: @item.TransactionStatus</span>
                                                </div>
                                                <h5 class="h6 fw-bold mb-1">
                                                    @if (item.VerificationStatus == PropLink.Domain.Enums.VerificationStatus.Approved)
                                                    {
                                                        <a asp-controller="Property" asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                                            @item.Title
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-dark">@item.Title</span>
                                                    }
                                                </h5>
                                                <div class="small text-muted mb-2">
                                                    <i class="bi bi-geo-alt me-1 text-danger"></i>@item.Location
                                                </div>
                                                <div class="fw-bold text-primary mb-2">
                                                    @item.Price.ToString("C0")
                                                </div>
                                            </div>

                                            @if (item.VerificationStatus == PropLink.Domain.Enums.VerificationStatus.Rejected)
                                            {
                                                <div class="alert alert-danger p-2 small mb-2 rounded-3">
                                                    <div class="fw-bold"><i class="bi bi-x-circle-fill me-1"></i> Rejection Reason:</div>
                                                    <div>@(string.IsNullOrEmpty(item.RejectionReason) ? "Documentation needs review." : item.RejectionReason)</div>
                                                </div>
                                                <div>
                                                    <a asp-controller="Property" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-100">
                                                        <i class="bi bi-arrow-repeat me-1"></i> Edit & Resubmit to Pending
                                                    </a>
                                                </div>
                                            }
                                            else if (item.VerificationStatus == PropLink.Domain.Enums.VerificationStatus.Pending)
                                            {
                                                <div class="alert alert-warning p-2 small mb-0 rounded-3">
                                                    <i class="bi bi-hourglass-split me-1"></i> Waiting for Admin document audit.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex justify-content-between align-items-center pt-2 border-top small">
                                                    <span class="text-success"><i class="bi bi-check-circle me-1"></i> Publicly Visible</span>
                                                    <a asp-controller="Property" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                                        View Details
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 bg-white">
                        <i class="bi bi-building-add fs-1 text-muted mb-2"></i>
                        <h5 class="fw-bold">You Have No Property Listings Yet</h5>
                        <p class="text-muted small max-w-500 mx-auto mb-3">
                            Ready to sell? Create a verified property listing by uploading photos and legal title documents.
                        </p>
                        <div>
                            <a asp-controller="Property" asp-action="Sell" class="btn btn-primary-custom px-4 py-2">
                                <i class="bi bi-plus-circle me-1"></i> List Your First Property
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- TAB 2: BUYING HISTORY -->
            <div class="tab-pane fade" id="buyingHistory" role="tabpanel" aria-labelledby="buying-tab">
                @if (Model.BuyingHistory.Any())
                {
                    <div class="row g-4">
                        @foreach (var purchase in Model.BuyingHistory)
                        {
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                                    <div class="row g-0 h-100">
                                        <div class="col-sm-5 position-relative">
                                            <img src="@purchase.PropertyImageUrl" class="img-fluid h-100 w-100" style="object-fit: cover; min-height: 180px;" alt="@purchase.PropertyTitle" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80';" />
                                            <span class="badge position-absolute top-0 start-0 m-2 bg-success">
                                                <i class="bi bi-shield-check me-1"></i> Verified
                                            </span>
                                        </div>
                                        <div class="col-sm-7 p-3 d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">@purchase.TransactionStatus</span>
                                                    <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i>@purchase.TransactionDate.ToString("MMM dd, yyyy")</span>
                                                </div>
                                                <h5 class="h6 fw-bold mb-1">
                                                    <a asp-controller="Property" asp-action="Details" asp-route-id="@purchase.PropertyId" class="text-dark text-decoration-none">
                                                        @purchase.PropertyTitle
                                                    </a>
                                                </h5>
                                                <div class="small text-muted mb-2">
                                                    <i class="bi bi-geo-alt me-1 text-danger"></i>@purchase.Location
                                                </div>
                                                <div class="fw-bold text-success mb-2">
                                                    Agreed: @purchase.AgreedPrice.ToString("C0")
                                                </div>
                                                @if (!string.IsNullOrEmpty(purchase.Notes))
                                                {
                                                    <p class="small text-muted mb-0 fst-italic">"@purchase.Notes"</p>
                                                }
                                            </div>

                                            <div class="pt-2 border-top mt-3 d-flex justify-content-between align-items-center">
                                                <span class="small text-success fw-semibold"><i class="bi bi-check2-all me-1"></i> Agreement On Record</span>
                                                <a asp-controller="Property" asp-action="Details" asp-route-id="@purchase.PropertyId" class="btn btn-sm btn-outline-custom">
                                                    View Property
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 bg-white">
                        <i class="bi bi-bag fs-1 text-muted mb-2"></i>
                        <h5 class="fw-bold">No Buying History Recorded</h5>
                        <p class="text-muted small max-w-500 mx-auto mb-3">
                            Explore verified listings across prime metropolitan areas and initiate direct purchase agreements with verified owners.
                        </p>
                        <div>
                            <a asp-controller="Property" asp-action="Index" class="btn btn-outline-custom px-4 py-2">
                                <i class="bi bi-search me-1"></i> Explore Verified Properties
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

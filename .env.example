# ==============================================================================
# PropLink Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# Do NOT commit your actual .env file to source control.
# ==============================================================================

# Application Settings
PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# TIP: For Docker / IPv4 networks, use Supabase Pooler (pooler.supabase.com)
# Session Pooler: Port 5432 | Transaction Pooler: Port 6543
# Pooler Username format: postgres.<PROJECT_REF>
# ------------------------------------------------------------------------------
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_db_password
DB_SSLMODE=Require

# Alternatively, you can supply the complete PostgreSQL connection string directly:
# ConnectionStrings__DefaultConnection="Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your_project_ref;Password=your_supabase_db_password;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Keepalive=30;"

# ------------------------------------------------------------------------------
# Cloudinary Configuration (Image / Asset Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Or complete Cloudinary URL:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ------------------------------------------------------------------------------
# Supabase Storage & REST API Credentials
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
